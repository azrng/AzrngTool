<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.TextHandle.JsonSchemaPageView"
    x:DataType="textHandle:JsonSchemaPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:textHandle="clr-namespace:AzrngTools.ViewModels.TextHandle"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：输入 / 输出双编辑器左右两列撑满视口，编辑器内部滚动 -->
    <Grid Margin="{StaticResource Thickness.15}">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.12}">
            <Border Grid.Column="0" Classes="tool-card-roomy" MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space.10}">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.8}">
                        <TextBlock
                            Classes="section-copy"
                            Text="JSON 输入"
                            VerticalAlignment="Center" />
                        <!-- 原「使用说明」教学卡压缩为一句提示，挂在说明图标上 -->
                        <Button
                            Grid.Column="1"
                            Classes="iconButton"
                            ToolTip.Tip="建议提供完整的 JSON 示例，字段层级更准确；数组会取首个有效元素推导集合项结构。">
                            <PathIcon
                                Data="M12 22C17.523 22 22 17.523 22 12C22 6.477 17.523 2 12 2C6.477 2 2 6.477 2 12C2 17.523 6.477 22 12 22ZM12 16V12M12 8H12.01"
                                Height="{StaticResource Layout.Icon.Sm}"
                                Width="{StaticResource Layout.Icon.Sm}" />
                        </Button>
                    </Grid>

                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        Classes="Standard"
                        MinHeight="0"
                        Text="{Binding OriginText}"
                        PlaceholderText="请输入 JSON 内容" />

                    <WrapPanel Grid.Row="2" Classes="tool-actions">
                        <Button
                            Classes="actionIcon"
                            Command="{Binding SchemaGenHandleCommand}"
                            CommandParameter="false"
                            Content="生成 Schema"
                            Tag="M12 3L14.2 8.1L19.8 8.7L15.6 12.4L16.8 18L12 15L7.2 18L8.4 12.4L4.2 8.7L9.8 8.1L12 3Z"
                            Theme="{DynamicResource SolidButton}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="tool-card-roomy" MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.8}">
                        <TextBlock
                            Classes="section-copy"
                            Text="Schema 输出"
                            VerticalAlignment="Center" />
                        <Border
                            Grid.Column="1"
                            Classes="badge-pill"
                            VerticalAlignment="Center">
                            <TextBlock Classes="badge-text" Text="只读" />
                        </Border>
                    </Grid>

                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        Classes="Standard"
                        MinHeight="0"
                        IsReadOnly="True"
                        Text="{Binding SchemaData}"
                        PlaceholderText="生成的 JSON Schema 将显示在这里" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
