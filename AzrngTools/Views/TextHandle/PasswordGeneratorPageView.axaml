<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.TextHandle.PasswordGeneratorPageView"
    x:DataType="textHandle:PasswordGeneratorPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:textHandle="clr-namespace:AzrngTools.ViewModels.TextHandle"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：上排「生成配置 + 单个结果」紧凑排布，下排「批量结果」撑满剩余高度并在内部滚动 -->
    <Grid
        Margin="{StaticResource Thickness.15}"
        RowDefinitions="Auto,*"
        RowSpacing="{StaticResource Space.12}">
        <Grid Grid.Row="0" ColumnDefinitions="0.9*,1.1*" ColumnSpacing="{StaticResource Space.12}">
            <!-- 生成配置 -->
            <Border Grid.Column="0" Classes="tool-card-roomy">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Space.10}">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.8}">
                        <TextBlock
                            Classes="section-copy"
                            Text="生成配置"
                            VerticalAlignment="Center" />
                        <!-- 原「提示」教学卡压缩为一句提示，挂在说明图标上 -->
                        <Button
                            Grid.Column="1"
                            Classes="iconButton"
                            ToolTip.Tip="单个与批量结果共用同一套配置；批量数量建议 1-100，强度标签在生成单个密码后自动刷新。">
                            <PathIcon
                                Data="M12 22C17.523 22 22 17.523 22 12C22 6.477 17.523 2 12 2C6.477 2 2 6.477 2 12C2 17.523 6.477 22 12 22ZM12 16V12M12 8H12.01"
                                Height="{StaticResource Layout.Icon.Sm}"
                                Width="{StaticResource Layout.Icon.Sm}" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Classes="tool-card-soft">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.16}" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Space.10}">
                            <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.10}">
                                <TextBlock Classes="metric-label" VerticalAlignment="Center" Text="长度" />
                                <NumericUpDown
                                    Grid.Column="1"
                                    Maximum="128"
                                    Minimum="4"
                                    Value="{Binding PasswordLength}" />
                            </Grid>

                            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.10}">
                                <TextBlock Classes="metric-label" VerticalAlignment="Center" Text="批量数量" />
                                <NumericUpDown
                                    Grid.Column="1"
                                    Maximum="100"
                                    Minimum="1"
                                    Value="{Binding BatchCount}" />
                            </Grid>

                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.10}">
                                <TextBlock Classes="metric-label" VerticalAlignment="Top" Text="字符类型" />
                                <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.16}" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Space.8}">
                                    <CheckBox Content="包含数字 (0-9)" IsChecked="{Binding IncludeNumbers}" />
                                    <CheckBox Grid.Column="1" Content="包含小写字母 (a-z)" IsChecked="{Binding IncludeLowercase}" />
                                    <CheckBox Grid.Row="1" Content="包含大写字母 (A-Z)" IsChecked="{Binding IncludeUppercase}" />
                                    <CheckBox Grid.Row="1" Grid.Column="1" Content="包含特殊字符 (!@#$%...)" IsChecked="{Binding IncludeSpecialChars}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 单个结果 -->
            <Border Grid.Column="1" Classes="tool-card-roomy">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Space.10}">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.10}">
                        <TextBlock
                            Classes="section-copy"
                            Text="单个结果"
                            VerticalAlignment="Center" />
                        <!-- 密码强度标签为功能性徽标，保留在卡片头部右侧 -->
                        <Border Grid.Column="1" Classes="badge-pill compact" VerticalAlignment="Center">
                            <TextBlock Classes="badge-text" Text="{Binding PasswordStrength, FallbackValue=未生成}" />
                        </Border>
                    </Grid>

                    <WrapPanel Grid.Row="1" Classes="tool-actions">
                        <Button
                            Classes="actionIcon"
                            Command="{Binding GeneratePasswordCommand}"
                            Content="生成密码"
                            Tag="M12 3L14.2 8.1L19.8 8.7L15.6 12.4L16.8 18L12 15L7.2 18L8.4 12.4L4.2 8.7L9.8 8.1L12 3Z"
                            Theme="{DynamicResource SolidButton}" />
                        <Button
                            Classes="actionIcon"
                            Command="{Binding GenerateRandomNumberCommand}"
                            Content="生成随机数"
                            Tag="M12 3L14.2 8.1L19.8 8.7L15.6 12.4L16.8 18L12 15L7.2 18L8.4 12.4L4.2 8.7L9.8 8.1L12 3Z"
                            Theme="{DynamicResource OutlineButton}" />
                        <Button
                            Classes="actionIcon"
                            Command="{Binding GenerateRandomStringCommand}"
                            Content="生成随机字符串"
                            Tag="M12 3L14.2 8.1L19.8 8.7L15.6 12.4L16.8 18L12 15L7.2 18L8.4 12.4L4.2 8.7L9.8 8.1L12 3Z"
                            Theme="{DynamicResource OutlineButton}" />
                    </WrapPanel>

                    <Border Grid.Row="2" Classes="tool-card-soft">
                        <TextBox
                            AcceptsReturn="True"
                            Background="{DynamicResource Brush.Surface.Transparent}"
                            BorderThickness="0"
                            Classes="Standard"
                            FontFamily="Consolas,monospace"
                            Height="{StaticResource Layout.Avatar.Md}"
                            IsReadOnly="True"
                            Text="{Binding GeneratedPassword}"
                            TextWrapping="Wrap"
                            PlaceholderText="生成结果会显示在这里" />
                    </Border>

                    <WrapPanel Grid.Row="3" Classes="tool-actions" HorizontalAlignment="Right">
                        <Button
                            Classes="actionIcon"
                            Command="{Binding CopyPasswordCommand}"
                            Content="复制结果"
                            Tag="M8 8H19V19H8V8ZM5 16H4V4H16V5"
                            Theme="{DynamicResource OutlineButton}" />
                        <Button
                            Classes="actionIcon"
                            Command="{Binding ClearCommand}"
                            Content="清空结果"
                            Tag="M5 7H19M9 7V5H15V7M8 10V17M12 10V17M16 10V17M7 7L8 20H16L17 7"
                            Theme="{DynamicResource OutlineButton}" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 批量结果：撑满剩余高度，列表内部滚动 -->
        <Border Grid.Row="1" Classes="tool-card-roomy" MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,Auto,*" RowSpacing="{StaticResource Space.10}">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.8}">
                    <TextBlock
                        Classes="section-copy"
                        Text="批量结果"
                        VerticalAlignment="Center" />
                    <WrapPanel Grid.Column="1" Classes="tool-actions">
                        <Button
                            Classes="actionIcon"
                            Command="{Binding GenerateBatchPasswordsCommand}"
                            Content="批量生成"
                            Tag="M12 3L14.2 8.1L19.8 8.7L15.6 12.4L16.8 18L12 15L7.2 18L8.4 12.4L4.2 8.7L9.8 8.1L12 3Z"
                            Theme="{DynamicResource SolidButton}" />
                        <Button
                            Classes="actionIcon"
                            Command="{Binding CopyAllPasswordsCommand}"
                            Content="复制全部"
                            Tag="M8 8H19V19H8V8ZM5 16H4V4H16V5"
                            Theme="{DynamicResource OutlineButton}" />
                        <Button
                            Classes="actionIcon"
                            Command="{Binding ClearBatchCommand}"
                            Content="清空列表"
                            Tag="M5 7H19M9 7V5H15V7M8 10V17M12 10V17M16 10V17M7 7L8 20H16L17 7"
                            Theme="{DynamicResource OutlineButton}" />
                    </WrapPanel>
                </Grid>

                <Border Grid.Row="2" Classes="tool-card-soft" MinHeight="0">
                    <ScrollViewer MinHeight="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding GeneratedPasswords}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border.Divider}" BorderThickness="0,0,0,1" Padding="{StaticResource Thickness.0.8}">
                                        <TextBlock
                                            FontFamily="Consolas,monospace"
                                            Text="{Binding}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
