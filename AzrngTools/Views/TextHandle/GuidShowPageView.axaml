<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.TextHandle.GuidShowPageView"
    x:DataType="vm:GuidShowPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AzrngTools.ViewModels.TextHandle"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：单一工作区卡撑满视口，五种格式行均分高度，只读文本框内部滚动 -->
    <Grid Margin="{StaticResource Thickness.15}">
        <Border Classes="tool-card-roomy" MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{StaticResource Space.8}">
                    <TextBlock
                        Classes="section-copy"
                        Text="GUID 生成结果"
                        VerticalAlignment="Center" />
                    <!-- 原「格式说明」教学卡压缩为一句提示，挂在说明图标上 -->
                    <Button
                        Grid.Column="1"
                        Classes="iconButton"
                        ToolTip.Tip="N：32 位无连接符；D：标准连字符格式；B / P：标准格式外层包大括号 / 圆括号；X：结构化十六进制格式。">
                        <PathIcon
                            Data="M12 22C17.523 22 22 17.523 22 12C22 6.477 17.523 2 12 2C6.477 2 2 6.477 2 12C2 17.523 6.477 22 12 22ZM12 16V12M12 8H12.01"
                            Height="{StaticResource Layout.Icon.Sm}"
                            Width="{StaticResource Layout.Icon.Sm}" />
                    </Button>

                    <WrapPanel Grid.Column="3" Classes="tool-actions" HorizontalAlignment="Right">
                        <Button
                            Classes="actionIcon"
                            Command="{Binding GenerateGuidCommand}"
                            Content="重新生成 GUID"
                            Tag="M19 8A7 7 0 1 0 20 12M19 4V8H15"
                            Theme="{DynamicResource SolidButton}" />
                    </WrapPanel>
                </Grid>

                <Grid Grid.Row="1" MinHeight="0" RowDefinitions="*,*,*,*,*" RowSpacing="{StaticResource Space.10}">
                    <Border Grid.Row="0" Classes="tool-card-soft" MinHeight="0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.8}">
                            <TextBlock
                                Classes="metric-label"
                                Text="N 格式"
                                VerticalAlignment="Center" />
                            <TextBox
                                Grid.Column="1"
                                Classes="Standard flat-readonly"
                                IsReadOnly="True"
                                Text="{Binding GuidN}"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Classes="tool-card-soft" MinHeight="0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.8}">
                            <TextBlock
                                Classes="metric-label"
                                Text="D 格式"
                                VerticalAlignment="Center" />
                            <TextBox
                                Grid.Column="1"
                                Classes="Standard flat-readonly"
                                IsReadOnly="True"
                                Text="{Binding GuidD}"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Classes="tool-card-soft" MinHeight="0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.8}">
                            <TextBlock
                                Classes="metric-label"
                                Text="B 格式"
                                VerticalAlignment="Center" />
                            <TextBox
                                Grid.Column="1"
                                Classes="Standard flat-readonly"
                                IsReadOnly="True"
                                Text="{Binding GuidB}"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Classes="tool-card-soft" MinHeight="0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.8}">
                            <TextBlock
                                Classes="metric-label"
                                Text="P 格式"
                                VerticalAlignment="Center" />
                            <TextBox
                                Grid.Column="1"
                                Classes="Standard flat-readonly"
                                IsReadOnly="True"
                                Text="{Binding GuidP}"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Classes="tool-card-soft" MinHeight="0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.8}">
                            <TextBlock
                                Classes="metric-label"
                                Text="X 格式"
                                VerticalAlignment="Center" />
                            <TextBox
                                Grid.Column="1"
                                Classes="Standard flat-readonly"
                                IsReadOnly="True"
                                Text="{Binding GuidX}"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
