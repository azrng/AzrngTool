<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.TextHandle.MarkdownPageView"
    x:DataType="textHandle:MarkdownPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
    xmlns:textHandle="clr-namespace:AzrngTools.ViewModels.TextHandle"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：输入 / 预览左右两列撑满视口，编辑与预览各自内部滚动 -->
    <Grid Margin="{StaticResource Thickness.15}">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.12}">
            <Border Grid.Column="0" Classes="tool-card-roomy" MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                    <TextBlock
                        Grid.Row="0"
                        Classes="section-copy"
                        Text="Markdown 输入"
                        VerticalAlignment="Center" />

                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        Classes="Standard"
                        MinHeight="0"
                        Text="{Binding MdText}"
                        PlaceholderText="请输入 Markdown 内容" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="tool-card-roomy" MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                    <TextBlock
                        Grid.Row="0"
                        Classes="section-copy"
                        Text="实时预览"
                        VerticalAlignment="Center" />

                    <Border Grid.Row="1" Classes="tool-card-soft" MinHeight="0">
                        <md:MarkdownScrollViewer Markdown="{Binding MdText}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
