<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.TextHandle.JsonToCsharpPageView"
    x:DataType="textHandle:JsonToCsharpPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:textHandle="clr-namespace:AzrngTools.ViewModels.TextHandle"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：顶部生成配置条(Auto) + 输入 / 输出双编辑器左右两列(*)撑满视口，编辑器内部滚动 -->
    <Grid Margin="{StaticResource Thickness.15}" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.12}">
        <Border Grid.Row="0" Classes="tool-card-roomy">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource Space.10}">
                <TextBlock
                    Grid.Row="0"
                    Classes="section-copy"
                    Text="生成配置"
                    VerticalAlignment="Center" />

                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.12}">
                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.8}">
                        <TextBlock
                            Classes="metric-label"
                            Text="根类名"
                            VerticalAlignment="Center" />
                        <TextBox
                            Grid.Column="1"
                            Classes="Standard"
                            Text="{Binding RootClassName}"
                            PlaceholderText="请输入根类名" />
                    </Grid>

                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.8}">
                        <TextBlock
                            Classes="metric-label"
                            Text="命名空间"
                            VerticalAlignment="Center" />
                        <TextBox
                            Grid.Column="1"
                            Classes="Standard"
                            Text="{Binding NameSpace}"
                            PlaceholderText="请输入命名空间" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.12}">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource Space.16}">
                        <CheckBox Content="使用可空类型" IsChecked="{Binding UseNullableTypes}" />
                        <CheckBox Content="使用帕斯卡命名法" IsChecked="{Binding UsePascalCase}" />
                        <CheckBox Content="生成属性" IsChecked="{Binding GenerateProperties}" />
                    </StackPanel>

                    <WrapPanel Grid.Column="1" Classes="tool-actions">
                        <Button
                            Classes="actionIcon"
                            Command="{Binding FormatJsonCommand}"
                            Content="格式化 JSON"
                            Tag="M4 5H20V19H4V5ZM8 9H16M8 13H13"
                            Theme="{DynamicResource OutlineButton}" />
                        <Button
                            Classes="actionIcon"
                            Command="{Binding ConvertToCsharpCommand}"
                            Content="转换为 C# 实体类"
                            Tag="M4 7H17M13 3L17 7L13 11"
                            Theme="{DynamicResource SolidButton}" />
                        <Button
                            Classes="actionIcon"
                            Command="{Binding CopyResultCommand}"
                            Content="复制结果"
                            Tag="M8 8H19V19H8V8ZM5 16H4V4H16V5"
                            Theme="{DynamicResource OutlineButton}" />
                        <Button
                            Classes="actionIcon"
                            Command="{Binding ClearCommand}"
                            Content="清空"
                            Tag="M5 7H19M9 7V5H15V7M8 10V17M12 10V17M16 10V17M7 7L8 20H16L17 7"
                            Theme="{DynamicResource OutlineButton}" />
                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" MinHeight="0" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.12}">
            <Border Grid.Column="0" Classes="tool-card-roomy" MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.8}">
                        <TextBlock
                            Classes="section-copy"
                            Text="JSON 输入"
                            VerticalAlignment="Center" />
                        <!-- 原「操作提示」教学卡压缩为一句提示，挂在说明图标上 -->
                        <Button
                            Grid.Column="1"
                            Classes="iconButton"
                            ToolTip.Tip="根节点需为对象，数组或简单值无法生成实体类；建议先格式化，更容易发现缺失逗号或层级错误。">
                            <PathIcon
                                Data="M12 22C17.523 22 22 17.523 22 12C22 6.477 17.523 2 12 2C6.477 2 2 6.477 2 12C2 17.523 6.477 22 12 22ZM12 16V12M12 8H12.01"
                                Height="{StaticResource Layout.Icon.Sm}"
                                Width="{StaticResource Layout.Icon.Sm}" />
                        </Button>
                    </Grid>

                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        Classes="Standard"
                        MinHeight="0"
                        Text="{Binding JsonInput}"
                        TextWrapping="Wrap"
                        PlaceholderText="请输入 JSON 内容" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="tool-card-roomy" MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.8}">
                        <TextBlock
                            Classes="section-copy"
                            Text="C# 代码输出"
                            VerticalAlignment="Center" />
                        <Border
                            Grid.Column="1"
                            Classes="badge-pill"
                            VerticalAlignment="Center">
                            <TextBlock Classes="badge-text" Text="只读" />
                        </Border>
                    </Grid>

                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        Classes="Standard"
                        FontFamily="Consolas,monospace"
                        MinHeight="0"
                        IsReadOnly="True"
                        Text="{Binding CsharpOutput}"
                        TextWrapping="Wrap"
                        PlaceholderText="生成的 C# 实体类代码将显示在这里" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
