<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.Encode.HexEncodePageView"
    x:DataType="encode:HexEncodePageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:encode="clr-namespace:AzrngTools.ViewModels.Encode"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：工作区(*)撑满视口；左右双编辑器随窗口拉伸并内部滚动，无页面标题卡与说明区 -->
    <Grid Margin="{StaticResource Thickness.15}" RowDefinitions="*" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.12}">
        <!-- 左列：输入与分隔符设置 -->
        <Border Grid.Column="0" Classes="tool-card-roomy" MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{StaticResource Space.10}">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.8}">
                    <TextBlock
                        Classes="section-copy"
                        Text="输入与格式"
                        VerticalAlignment="Center" />
                    <!-- 操作提示压缩为工具提示，替代原“输入提示”说明卡 -->
                    <Button
                        Grid.Column="1"
                        Classes="iconButton"
                        ToolTip.Tip="十六进制输入支持空格、短横线与 0x / 0X 前缀，字符长度必须为偶数。">
                        <PathIcon
                            Data="M12 16V12M12 8H12.01M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z"
                            Height="{StaticResource Layout.Icon.Sm}"
                            Width="{StaticResource Layout.Icon.Sm}" />
                    </Button>
                </Grid>

                <!-- 分隔符选择为功能性设置，保留在编辑器上方 -->
                <Border Grid.Row="1" Classes="tool-card-soft">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.10}">
                        <TextBlock Classes="metric-label" VerticalAlignment="Center" Text="分隔符" />
                        <ComboBox
                            Grid.Column="1"
                            SelectedIndex="{Binding SeparatorIndex}"
                            Theme="{DynamicResource OutlineComboBox}">
                            <ComboBoxItem Content="空格" Tag=" " />
                            <ComboBoxItem Content="无" Tag="" />
                            <ComboBoxItem Content="短横线" Tag="-" />
                            <ComboBoxItem Content="冒号" Tag=":" />
                        </ComboBox>
                    </Grid>
                </Border>

                <TextBox
                    Grid.Row="2"
                    AcceptsReturn="True"
                    Classes="Standard"
                    MinHeight="0"
                    PlaceholderText="请输入要转换的内容"
                    Text="{Binding Original}"
                    TextWrapping="Wrap" />

                <WrapPanel Grid.Row="3" Classes="tool-actions">
                    <Button
                        Classes="actionIcon"
                        Command="{Binding StringToHexCommand}"
                        Content="字符串转十六进制"
                        Tag="M4 7H17M13 3L17 7L13 11"
                        Theme="{DynamicResource SolidButton}" />
                    <Button
                        Classes="actionIcon"
                        Command="{Binding HexToStringCommand}"
                        Content="十六进制转字符串"
                        Tag="M7 13L3 17L7 21M3 17H16"
                        Theme="{DynamicResource SolidButton}" />
                    <Button
                        Classes="actionIcon"
                        Command="{Binding BytesToHexCommand}"
                        Content="字节数组转十六进制"
                        Tag="M4 5H20V19H4V5ZM8 9H16M8 13H13"
                        Theme="{DynamicResource OutlineButton}" />
                    <Button
                        Classes="actionIcon"
                        Command="{Binding HexToBytesCommand}"
                        Content="十六进制转字节数组"
                        Tag="M4 5H20V19H4V5ZM8 9H16M8 13H13"
                        Theme="{DynamicResource OutlineButton}" />
                    <Button
                        Classes="actionIcon"
                        Command="{Binding ClearCommand}"
                        Content="清空"
                        Tag="M5 7H19M9 7V5H15V7M8 10V17M12 10V17M16 10V17M7 7L8 20H16L17 7"
                        Theme="{DynamicResource OutlineButton}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 右列：结果卡，只读编辑器撑满 -->
        <Border Grid.Column="1" Classes="tool-card-roomy" MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space.10}">
                <TextBlock
                    Grid.Row="0"
                    Classes="section-copy"
                    Text="处理结果"
                    VerticalAlignment="Center" />

                <TextBox
                    Grid.Row="1"
                    AcceptsReturn="True"
                    Classes="Standard"
                    MinHeight="0"
                    IsReadOnly="True"
                    PlaceholderText="处理后的内容会显示在这里"
                    Text="{Binding HandleText}"
                    TextWrapping="Wrap" />

                <WrapPanel Grid.Row="2" Classes="tool-actions">
                    <Button
                        Classes="actionIcon"
                        Command="{Binding CopyResultCommand}"
                        Content="复制结果"
                        Tag="M8 8H19V19H8V8ZM5 16H4V4H16V5"
                        Theme="{DynamicResource OutlineButton}" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
