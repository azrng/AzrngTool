<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.Encode.UnicodeEncodePageView"
    x:DataType="encode:UnicodeEncodePageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:encode="clr-namespace:AzrngTools.ViewModels.Encode"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：工作区(*)撑满视口；左右双编辑器随窗口拉伸并内部滚动，无页面标题卡与说明区 -->
    <Grid Margin="{StaticResource Thickness.15}" RowDefinitions="*" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.12}">
        <!-- 左列：输入卡 -->
        <Border Grid.Column="0" Classes="tool-card-roomy" MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space.10}">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.8}">
                    <TextBlock
                        Classes="section-copy"
                        Text="输入内容"
                        VerticalAlignment="Center" />
                    <!-- 操作提示压缩为工具提示，替代原“输入建议”说明卡 -->
                    <Button
                        Grid.Column="1"
                        Classes="iconButton"
                        ToolTip.Tip="普通文本转换执行“Unicode 编码”，内容已是 \uXXXX 形式时执行“Unicode 解码”。">
                        <PathIcon
                            Data="M12 16V12M12 8H12.01M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z"
                            Height="{StaticResource Layout.Icon.Sm}"
                            Width="{StaticResource Layout.Icon.Sm}" />
                    </Button>
                </Grid>

                <TextBox
                    Grid.Row="1"
                    AcceptsReturn="True"
                    Classes="Standard"
                    MinHeight="0"
                    PlaceholderText="请输入要编码或解码的文本"
                    Text="{Binding Original}" />

                <WrapPanel Grid.Row="2" Classes="tool-actions">
                    <Button
                        Classes="actionIcon"
                        Command="{Binding UnicodeEncodeCommand}"
                        Content="Unicode 编码"
                        Tag="M4 7H17M13 3L17 7L13 11"
                        Theme="{DynamicResource SolidButton}" />
                    <Button
                        Classes="actionIcon"
                        Command="{Binding UnicodeDecodeCommand}"
                        Content="Unicode 解码"
                        Tag="M7 13L3 17L7 21M3 17H16"
                        Theme="{DynamicResource SolidButton}" />
                    <Button
                        Classes="actionIcon"
                        Command="{Binding ClearCommand}"
                        Content="清空"
                        Tag="M5 7H19M9 7V5H15V7M8 10V17M12 10V17M16 10V17M7 7L8 20H16L17 7"
                        Theme="{DynamicResource OutlineButton}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 右列：结果卡，只读编辑器撑满 -->
        <Border Grid.Column="1" Classes="tool-card-roomy" MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space.10}">
                <TextBlock
                    Grid.Row="0"
                    Classes="section-copy"
                    Text="处理结果"
                    VerticalAlignment="Center" />

                <TextBox
                    Grid.Row="1"
                    AcceptsReturn="True"
                    Classes="Standard"
                    MinHeight="0"
                    IsReadOnly="True"
                    PlaceholderText="处理后的内容会显示在这里"
                    Text="{Binding HandleText}" />

                <WrapPanel Grid.Row="2" Classes="tool-actions">
                    <Button
                        Classes="actionIcon"
                        Command="{Binding CopyResultCommand}"
                        Content="复制结果"
                        Tag="M8 8H19V19H8V8ZM5 16H4V4H16V5"
                        Theme="{DynamicResource OutlineButton}" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
