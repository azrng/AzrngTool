<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.Encode.Base64ToImagePageView"
    x:DataType="encode:Base64ToImagePageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:encode="clr-namespace:AzrngTools.ViewModels.Encode"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：表单/结果型页面，工作区(*)撑满视口；预览卡内部滚动，无页面标题卡 -->
    <Grid Margin="{StaticResource Thickness.15}" RowDefinitions="*" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.12}">
        <!-- 左列：Base64 输入与操作 -->
        <Border Grid.Column="0" Classes="tool-card-roomy" MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space.10}">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.8}">
                    <TextBlock
                        Classes="section-copy"
                        Text="Base64 输入"
                        VerticalAlignment="Center" />
                    <!-- 输入提示压缩为工具提示，替代原“输入提示”说明卡 -->
                    <Button
                        Grid.Column="1"
                        Classes="iconButton"
                        ToolTip.Tip="超长内容建议先“从剪贴板粘贴”导入再转换，可减少直接输入时的界面卡顿。">
                        <PathIcon
                            Data="M12 16V12M12 8H12.01M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z"
                            Height="{StaticResource Layout.Icon.Sm}"
                            Width="{StaticResource Layout.Icon.Sm}" />
                    </Button>
                </Grid>

                <TextBox
                    Grid.Row="1"
                    AcceptsReturn="True"
                    Classes="Standard"
                    MinHeight="0"
                    Text="{Binding Base64String, UpdateSourceTrigger=LostFocus}"
                    PlaceholderText="请输入 Base64 字符串（支持带或不带 data:image/...;base64, 前缀）" />

                <WrapPanel Grid.Row="2" Classes="tool-actions">
                    <Button
                        Classes="actionIcon"
                        Command="{Binding PasteFromClipboardCommand}"
                        Content="从剪贴板粘贴"
                        Tag="M5 4H19V20H5V4ZM8 8H16M8 12H16M8 16H13"
                        Theme="{DynamicResource OutlineButton}" />
                    <Button
                        Classes="actionIcon"
                        Command="{Binding ConvertToImageCommand}"
                        Content="转换为图片"
                        Tag="M4 7H17M13 3L17 7L13 11"
                        Theme="{DynamicResource SolidButton}" />
                    <Button
                        Classes="actionIcon"
                        Command="{Binding SaveImageCommand}"
                        Content="保存图片"
                        Tag="M12 4V16M8 12L12 16L16 12M5 20H19"
                        IsEnabled="{Binding HasImage}"
                        Theme="{DynamicResource SolidButton}" />
                    <Button
                        Classes="actionIcon"
                        Command="{Binding ClearCommand}"
                        Content="清空"
                        Tag="M5 7H19M9 7V5H15V7M8 10V17M12 10V17M16 10V17M7 7L8 20H16L17 7"
                        Theme="{DynamicResource OutlineButton}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 右列：图片预览，随窗口撑满并在内部滚动 -->
        <Border Grid.Column="1" Classes="tool-card-roomy" MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Space.8}">
                    <TextBlock
                        Classes="section-copy"
                        Text="图片预览"
                        VerticalAlignment="Center" />
                    <Border
                        Grid.Column="1"
                        Classes="badge-pill compact"
                        IsVisible="{Binding HasImage}"
                        VerticalAlignment="Center">
                        <TextBlock Classes="badge-text" Text="{Binding ImageBytes.Length, StringFormat='大小 {0} 字节'}" />
                    </Border>
                </Grid>

                <Border
                    Grid.Row="1"
                    Classes="tool-card-soft"
                    MinHeight="0"
                    Padding="{StaticResource Thickness.12}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Height="396" Width="640">
                                <Image
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding HasImage}"
                                    Source="{Binding PreviewImage}"
                                    Stretch="Uniform"
                                    VerticalAlignment="Center" />
                                <StackPanel HorizontalAlignment="Center" IsVisible="{Binding !HasImage}" Spacing="{StaticResource Space.6}" VerticalAlignment="Center">
                                    <TextBlock Classes="section-title" HorizontalAlignment="Center" Text="等待图片预览" />
                                    <TextBlock Classes="section-copy" HorizontalAlignment="Center" Text="完成转换后会在这里显示图片内容。" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
