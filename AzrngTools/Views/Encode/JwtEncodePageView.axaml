<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.Encode.JwtEncodePageView"
    x:DataType="vm:JwtEncodePageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
    xmlns:behaviors="clr-namespace:AzrngTools.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:vm="clr-namespace:AzrngTools.ViewModels.Encode"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：工作区(*)撑满视口 + 贴底状态细条(Auto，未输入令牌时隐藏)；编辑器随窗口拉伸并内部滚动 -->
    <Grid Margin="{StaticResource Thickness.15}" RowDefinitions="*,Auto" RowSpacing="{StaticResource Space.12}">
        <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.12}">
            <!-- 左列：JWT 输入卡 -->
            <Border Grid.Column="0" Classes="tool-card-roomy" MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space.10}">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource Space.8}">
                        <TextBlock
                            Classes="section-copy"
                            Text="JWT 输入"
                            VerticalAlignment="Center" />
                        <Border
                            Grid.Column="1"
                            Classes="badge-pill compact"
                            VerticalAlignment="Center">
                            <TextBlock Classes="badge-text" Text="{Binding JwtCharacterCount, StringFormat='字符 {0}'}" />
                        </Border>
                        <!-- 操作提示压缩为工具提示，替代原“输入提示”“使用说明”说明区 -->
                        <Button
                            Grid.Column="2"
                            Classes="iconButton"
                            ToolTip.Tip="粘贴完整 JWT（支持 Bearer 前缀）后自动解析；令牌至少包含 Header 与 Payload 两段，本页仅解析结构，不验证签名。">
                            <PathIcon
                                Data="M12 16V12M12 8H12.01M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z"
                                Height="{StaticResource Layout.Icon.Sm}"
                                Width="{StaticResource Layout.Icon.Sm}" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Classes="tool-card-soft" MinHeight="0">
                        <avaloniaEdit:TextEditor
                            FontFamily="Consolas,monospace"
                            HorizontalScrollBarVisibility="Auto"
                            MinHeight="0"
                            Name="JwtText"
                            Padding="{StaticResource Thickness.8}"
                            behaviors:TextEditorBinding.Text="{Binding Original, Mode=TwoWay}"
                            ShowLineNumbers="True"
                            SyntaxHighlighting="Json"
                            VerticalScrollBarVisibility="Visible"
                            WordWrap="True">
                            <avaloniaEdit:TextEditor.Options>
                                <avaloniaEdit:TextEditorOptions ShowSpaces="False">
                                    <avaloniaEdit:TextEditorOptions.ColumnRulerPositions>
                                        <system:Int32>10</system:Int32>
                                    </avaloniaEdit:TextEditorOptions.ColumnRulerPositions>
                                </avaloniaEdit:TextEditorOptions>
                            </avaloniaEdit:TextEditor.Options>
                        </avaloniaEdit:TextEditor>
                    </Border>

                    <WrapPanel Grid.Row="2" Classes="tool-actions">
                        <Button
                            Classes="actionIcon"
                            Command="{Binding CopyHeaderCommand}"
                            Content="复制 Header"
                            Tag="M8 8H19V19H8V8ZM5 16H4V4H16V5"
                            IsEnabled="{Binding HasHeader}"
                            Theme="{DynamicResource OutlineButton}" />
                        <Button
                            Classes="actionIcon"
                            Command="{Binding CopyPayloadCommand}"
                            Content="复制 Payload"
                            Tag="M8 8H19V19H8V8ZM5 16H4V4H16V5"
                            IsEnabled="{Binding HasPayload}"
                            Theme="{DynamicResource OutlineButton}" />
                        <Button
                            Classes="actionIcon"
                            Command="{Binding ClearCommand}"
                            Content="清空"
                            Tag="M5 7H19M9 7V5H15V7M8 10V17M12 10V17M16 10V17M7 7L8 20H16L17 7"
                            Theme="{DynamicResource OutlineButton}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- 右列：解析结果卡，Header / Payload 双列撑满 -->
            <Border Grid.Column="1" Classes="tool-card-roomy" MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                    <TextBlock
                        Grid.Row="0"
                        Classes="section-copy"
                        Text="解析结果"
                        VerticalAlignment="Center" />

                    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.10}">
                        <Border Grid.Column="0" Classes="tool-card-soft" MinHeight="0">
                            <Grid MinHeight="0" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space.8}">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.8}">
                                    <TextBlock Classes="metric-label" Text="Header" />
                                    <Border Grid.Column="1" Classes="badge-pill compact">
                                        <TextBlock Classes="badge-text" Text="{Binding HeaderCharacterCount, StringFormat='字符 {0}'}" />
                                    </Border>
                                </Grid>

                                <TextBox
                                    Grid.Row="1"
                                    AcceptsReturn="True"
                                    Classes="Standard"
                                    MinHeight="0"
                                    IsReadOnly="True"
                                    PlaceholderText="Header"
                                    Text="{Binding HeaderText}" />

                                <Button
                                    Grid.Row="2"
                                    Classes="actionIcon"
                                    Command="{Binding CopyHeaderCommand}"
                                    Content="复制 Header"
                                    Tag="M8 8H19V19H8V8ZM5 16H4V4H16V5"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{Binding HasHeader}"
                                    Theme="{DynamicResource OutlineButton}" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Classes="tool-card-soft" MinHeight="0">
                            <Grid MinHeight="0" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space.8}">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.8}">
                                    <TextBlock Classes="metric-label" Text="Payload" />
                                    <Border Grid.Column="1" Classes="badge-pill compact">
                                        <TextBlock Classes="badge-text" Text="{Binding PayloadCharacterCount, StringFormat='字符 {0}'}" />
                                    </Border>
                                </Grid>

                                <TextBox
                                    Grid.Row="1"
                                    AcceptsReturn="True"
                                    Classes="Standard"
                                    MinHeight="0"
                                    IsReadOnly="True"
                                    PlaceholderText="Payload"
                                    Text="{Binding PayloadText}" />

                                <Button
                                    Grid.Row="2"
                                    Classes="actionIcon"
                                    Command="{Binding CopyPayloadCommand}"
                                    Content="复制 Payload"
                                    Tag="M8 8H19V19H8V8ZM5 16H4V4H16V5"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{Binding HasPayload}"
                                    Theme="{DynamicResource OutlineButton}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 贴底状态细条：保留原“当前状态”展示，无成功/失败布尔属性，仅简单展示 -->
        <Border Grid.Row="1" Classes="status-strip" IsVisible="{Binding HasJwtInput}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.12}">
                <TextBlock Classes="status-strip-text" Text="{Binding HasJwtInput, StringFormat='已输入令牌：{0}'}" />
                <TextBlock Classes="status-strip-text" Text="{Binding HasHeader, StringFormat='Header 可复制：{0}'}" />
                <TextBlock Classes="status-strip-text" Text="{Binding HasPayload, StringFormat='Payload 可复制：{0}'}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
