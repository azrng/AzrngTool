<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.Other.TranslatorPageView"
    x:DataType="vm:TranslatorPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:AzrngTools.ViewModels.Other"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：左列原文编辑器+翻译操作，右列只读结果，双列撑满视口；
         编辑器随窗口拉伸并在内部滚动 -->
    <Grid Margin="{StaticResource Thickness.15}" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.12}">
        <!-- 左列：原文与翻译操作 -->
        <Border Grid.Column="0" Classes="tool-card-roomy" MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space.10}">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource Space.8}">
                    <TextBlock
                        Classes="section-copy"
                        Text="原文"
                        VerticalAlignment="Center" />

                    <!-- 翻译服务与方向保持原有绑定 -->
                    <ComboBox
                        Grid.Column="2"
                        MinWidth="130"
                        VerticalAlignment="Center"
                        SelectedIndex="0">
                        <ComboBoxItem Content="Yandex 翻译" />
                    </ComboBox>
                    <ComboBox
                        Grid.Column="3"
                        MinWidth="110"
                        VerticalAlignment="Center"
                        SelectedIndex="{Binding TranslatorTypeIndex}">
                        <ComboBoxItem>中译英</ComboBoxItem>
                        <ComboBoxItem>英译中</ComboBoxItem>
                    </ComboBox>
                </Grid>

                <TextBox
                    Grid.Row="1"
                    AcceptsReturn="True"
                    Classes="Standard"
                    MinHeight="0"
                    PlaceholderText="请输入要转换的内容"
                    Text="{Binding OriginText}" />

                <!-- 翻译按钮与忙碌状态 -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.10}">
                    <Button
                        Command="{Binding HandlerCommand}"
                        IsEnabled="{Binding CanTranslate}"
                        Theme="{DynamicResource SolidButton}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                            <PathIcon
                                Data="M4 5H20M4 12H20M4 19H20M8 2L5 5L8 8M16 9L19 12L16 15M8 16L5 19L8 22"
                                Foreground="{DynamicResource Brush.Text.OnAccent}"
                                Height="{StaticResource Layout.Icon.Sm}"
                                Width="{StaticResource Layout.Icon.Sm}" />
                            <TextBlock Text="翻译" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Grid.Column="1" Classes="tool-card-soft" IsVisible="{Binding IsBusy}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.8}">
                            <ProgressBar Width="110" IsIndeterminate="True" />
                            <TextBlock Classes="section-copy" Text="{Binding BusyText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 右列：只读翻译结果 -->
        <Border Grid.Column="1" Classes="tool-card-roomy" MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space.8}">
                    <TextBlock
                        Classes="section-copy"
                        Text="翻译结果"
                        VerticalAlignment="Center" />
                    <Border
                        Grid.Column="2"
                        Classes="badge-pill"
                        VerticalAlignment="Center">
                        <TextBlock Classes="badge-text" Text="只读" />
                    </Border>
                </Grid>

                <TextBox
                    Grid.Row="1"
                    AcceptsReturn="True"
                    Classes="Standard"
                    MinHeight="0"
                    IsReadOnly="True"
                    PlaceholderText="输出的结果"
                    Text="{Binding ResultText}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
