<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.Other.UnixTimestampPageView"
    x:DataType="other:UnixTimestampPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:other="clr-namespace:AzrngTools.ViewModels.Other"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：顶部当前时间戳细条(Auto) + 中部转换工作区(*)撑满视口 + 贴底结果区(Auto) -->
    <Grid Margin="{StaticResource Thickness.15}" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space.12}">
        <!-- 顶部：当前秒级 / 毫秒级时间戳与刷新、复制操作 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,Auto" ColumnSpacing="{StaticResource Space.12}">
            <Border Grid.Column="0" Classes="tool-card-soft">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Space.6}">
                    <TextBlock Classes="metric-label" Text="当前秒级时间戳" />
                    <TextBlock Grid.Row="1" Classes="metric-value" Text="{Binding CurrentTimestampSeconds}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="tool-card-soft">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Space.6}">
                    <TextBlock Classes="metric-label" Text="当前毫秒级时间戳" />
                    <TextBlock Grid.Row="1" Classes="metric-value" Text="{Binding CurrentTimestampMilliseconds}" />
                </Grid>
            </Border>

            <WrapPanel Grid.Column="2" Classes="tool-actions" VerticalAlignment="Center">
                <Button
                    Classes="actionIcon"
                    Command="{Binding RefreshCurrentTimestampCommand}"
                    Content="刷新时间戳"
                    Tag="M19 8A7 7 0 1 0 20 12M19 4V8H15"
                    Theme="{DynamicResource OutlineButton}" />
                <Button
                    Classes="actionIcon"
                    Command="{Binding CopyCurrentTimestampCommand}"
                    Content="复制当前值"
                    Tag="M8 8H19V19H8V8ZM5 16H4V4H16V5"
                    Theme="{DynamicResource OutlineButton}" />
            </WrapPanel>
        </Grid>

        <!-- 中部：左右两个转换工作区，撑满剩余视口 -->
        <Grid Grid.Row="1" MinHeight="0" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.12}">
            <!-- 左列：时间戳转日期时间 -->
            <Border Grid.Column="0" Classes="tool-card-roomy" MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*,*" RowSpacing="{StaticResource Space.10}">
                    <TextBlock
                        Grid.Row="0"
                        Classes="section-copy"
                        Text="时间戳转日期时间"
                        VerticalAlignment="Center" />

                    <!-- 秒级输入组：按钮只处理本组输入框的值 -->
                    <Border Grid.Row="1" Classes="tool-card-soft">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource Space.8}">
                            <TextBlock Classes="metric-label" Text="秒级时间戳输入" />
                            <TextBox
                                Grid.Row="1"
                                Classes="Standard"
                                Text="{Binding TimestampSeconds}"
                                PlaceholderText="请输入秒级时间戳" />
                            <Button
                                Classes="actionIcon"
                                Grid.Row="2"
                                Command="{Binding TimestampToDateTimeSecondsCommand}"
                                Content="把上面的秒级时间戳转成日期时间"
                                Tag="M4 7H17M13 3L17 7L13 11"
                                HorizontalAlignment="Stretch"
                                Theme="{DynamicResource SolidButton}" />
                        </Grid>
                    </Border>

                    <!-- 毫秒级输入组：按钮只处理本组输入框的值 -->
                    <Border Grid.Row="2" Classes="tool-card-soft">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource Space.8}">
                            <TextBlock Classes="metric-label" Text="毫秒级时间戳输入" />
                            <TextBox
                                Grid.Row="1"
                                Classes="Standard"
                                Text="{Binding TimestampMilliseconds}"
                                PlaceholderText="请输入毫秒级时间戳" />
                            <Button
                                Classes="actionIcon"
                                Grid.Row="2"
                                Command="{Binding TimestampToDateTimeMillisecondsCommand}"
                                Content="把上面的毫秒级时间戳转成日期时间"
                                Tag="M4 7H17M13 3L17 7L13 11"
                                HorizontalAlignment="Stretch"
                                Theme="{DynamicResource SolidButton}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 右列：日期时间转时间戳 -->
            <Border Grid.Column="1" Classes="tool-card-roomy" MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space.10}">
                    <TextBlock
                        Grid.Row="0"
                        Classes="section-copy"
                        Text="日期时间转时间戳"
                        VerticalAlignment="Center" />

                    <Grid Grid.Row="1" MinHeight="0" ColumnDefinitions="1*,1*" ColumnSpacing="{StaticResource Space.10}">
                        <Border Grid.Column="0" Classes="tool-card-soft">
                            <StackPanel Spacing="{StaticResource Space.8}">
                                <TextBlock Classes="metric-label" Text="选择日期" />
                                <CalendarDatePicker
                                    HorizontalAlignment="Stretch"
                                    IsTodayHighlighted="True"
                                    SelectedDate="{Binding TargetDateSelection}" />
                                <TextBlock Classes="metric-label" Text="选择时间" />
                                <TimePicker
                                    HorizontalAlignment="Stretch"
                                    MinWidth="0"
                                    SelectedTime="{Binding TargetTimeSelection}" />
                            </StackPanel>
                        </Border>

                        <!-- 回填区只负责展示生成的时间戳 -->
                        <Border Grid.Column="1" Classes="tool-card-soft">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Space.8}">
                                <TextBlock Classes="metric-label" Text="自动回填的时间戳" />
                                <TextBlock Grid.Row="1" Classes="Small" Text="秒级" />
                                <TextBox
                                    Grid.Row="2"
                                    Classes="Standard"
                                    IsReadOnly="True"
                                    Text="{Binding TargetTimestampSeconds}" />
                                <TextBlock Grid.Row="3" Classes="Small" Text="毫秒级" />
                                <TextBox
                                    Grid.Row="4"
                                    Classes="Standard"
                                    IsReadOnly="True"
                                    Text="{Binding TargetTimestampMilliseconds}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <WrapPanel Grid.Row="2" Classes="tool-actions" HorizontalAlignment="Right">
                        <Button
                            Classes="actionIcon"
                            Command="{Binding DateTimeToTimestampCommand}"
                            Content="根据当前日期时间生成时间戳"
                            Tag="M4 7H17M13 3L17 7L13 11"
                            Theme="{DynamicResource SolidButton}" />
                        <Button
                            Classes="actionIcon"
                            Command="{Binding SetToNowCommand}"
                            Content="把日期时间设为现在"
                            Tag="M19 8A7 7 0 1 0 20 12M19 4V8H15"
                            Theme="{DynamicResource OutlineButton}" />
                        <Button
                            Classes="actionIcon"
                            Command="{Binding ClearCommand}"
                            Content="清空底部结果"
                            Tag="M5 7H19M9 7V5H15V7M8 10V17M12 10V17M16 10V17M7 7L8 20H16L17 7"
                            Theme="{DynamicResource OutlineButton}" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部：全页唯一转换结果出口，贴工作区底部 -->
        <Border Grid.Row="2" Classes="tool-card-roomy">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Space.8}">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.10}">
                    <TextBlock
                        Classes="section-copy"
                        Text="转换结果"
                        VerticalAlignment="Center" />
                    <Button
                        Classes="actionIcon"
                        Grid.Column="1"
                        Command="{Binding CopyResultCommand}"
                        Content="复制结果"
                        Tag="M8 8H19V19H8V8ZM5 16H4V4H16V5"
                        Theme="{DynamicResource OutlineButton}" />
                </Grid>

                <Border Grid.Row="1" Classes="tool-card-soft">
                    <TextBlock
                        Classes="code-output"
                        MinHeight="96"
                        Text="{Binding ConversionResult, FallbackValue=尚未生成转换结果}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
