<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.Format.XmlToHtmlPageView"
    x:DataType="format:XmlToHtmlPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:format="clr-namespace:AzrngTools.ViewModels.Format"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：转换操作条固定高度，双输入列与输出区按 * 行撑满视口，文本框内部滚动 -->
    <Grid Margin="{StaticResource Thickness.15}" RowDefinitions="Auto,*,*" RowSpacing="{StaticResource Space.12}">
        <Border Grid.Row="0" Classes="tool-card-roomy">
            <Grid
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="{StaticResource Space.8}">
                <TextBlock
                    Classes="section-copy"
                    Text="XML + XSLT 转 HTML"
                    VerticalAlignment="Center" />

                <WrapPanel Grid.Column="1" Classes="tool-actions">
                    <Button
                        Classes="actionIcon"
                        Command="{Binding HandleCommand}"
                        Content="转换 XML"
                        Tag="M4 7H17M13 3L17 7L13 11"
                        Theme="{DynamicResource SolidButton}" />
                </WrapPanel>

                <!-- 原「使用提示」卡压缩为一句提示，挂在说明图标上 -->
                <Button
                    Grid.Column="2"
                    Classes="iconButton"
                    VerticalAlignment="Center"
                    ToolTip.Tip="XML 与 XSLT 两个输入都不能为空，缺省时会提示补全；转换结果会显示在下方 HTML 输出区。">
                    <PathIcon
                        Data="M12 22C17.523 22 22 17.523 22 12C22 6.477 17.523 2 12 2C6.477 2 2 6.477 2 12C2 17.523 6.477 22 12 22ZM12 16V12M12 8H12.01"
                        Height="{StaticResource Layout.Icon.Sm}"
                        Width="{StaticResource Layout.Icon.Sm}" />
                </Button>
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*"
            ColumnSpacing="{StaticResource Space.12}">
            <Border
                Grid.Column="0"
                Classes="tool-card-roomy"
                MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                    <TextBlock
                        Grid.Row="0"
                        Classes="section-copy"
                        Text="XML 输入"
                        VerticalAlignment="Center" />

                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        Classes="Standard"
                        MinHeight="0"
                        Text="{Binding XmlContent}"
                        PlaceholderText="请输入 XML 内容" />
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Classes="tool-card-roomy"
                MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                    <TextBlock
                        Grid.Row="0"
                        Classes="section-copy"
                        Text="XSLT 输入"
                        VerticalAlignment="Center" />

                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        Classes="Standard"
                        MinHeight="0"
                        Text="{Binding XsltContent}"
                        PlaceholderText="请输入 XSLT 内容" />
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Classes="tool-card-roomy"
            MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="{StaticResource Space.8}">
                    <TextBlock
                        Classes="section-copy"
                        Text="HTML 输出"
                        VerticalAlignment="Center" />
                    <!-- 功能性只读徽标保留在输出卡头部右侧 -->
                    <Border
                        Grid.Column="1"
                        Classes="badge-pill"
                        VerticalAlignment="Center">
                        <TextBlock Classes="badge-text" Text="只读" />
                    </Border>
                </Grid>

                <TextBox
                    Grid.Row="1"
                    AcceptsReturn="True"
                    Classes="Standard"
                    MinHeight="0"
                    IsReadOnly="True"
                    Text="{Binding HtmlContent}"
                    PlaceholderText="HTML 内容" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
