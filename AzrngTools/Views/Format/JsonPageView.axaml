<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.Format.JsonPageView"
    x:DataType="vm:JsonPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
    xmlns:behaviors="clr-namespace:AzrngTools.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:vm="using:AzrngTools.ViewModels.Format"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局样板：无页面标题卡，编辑区单卡撑满视口，编辑器内部滚动 -->
    <Grid Margin="{StaticResource Thickness.15}"
          MinHeight="0"
          RowDefinitions="*"
          x:Name="RootGrid">
        <Border
            Grid.Row="0"
            Classes="tool-card-roomy"
            MinHeight="0"
            x:Name="JsonWorkspaceCard">
            <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.12}">
                    <TextBlock Classes="section-title"
                               Text="编辑区"
                               VerticalAlignment="Center" />

                    <WrapPanel Grid.Column="1" Classes="tool-actions" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button
                            Command="{Binding FormatJsonCommand}"
                            Theme="{DynamicResource SolidButton}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                <PathIcon Data="M4 5H20M4 12H16M4 19H12" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                <TextBlock Text="格式化" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding CompressJsonCommand}"
                            Theme="{DynamicResource SolidButton}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                <PathIcon Data="M7 4V20M17 4V20M4 7L7 4L10 7M14 17L17 20L20 17" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                <TextBlock Text="压缩" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding EscapeJsonCommand}"
                            Theme="{DynamicResource OutlineButton}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                <PathIcon Data="M5 5L19 19M19 5L5 19" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                <TextBlock Text="转义" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding CompressEscapeJsonCommand}"
                            Theme="{DynamicResource OutlineButton}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                <PathIcon Data="M7 4V20M17 4V20M5 5L19 19" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                <TextBlock Text="压缩并转义" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding ReplaceEscapeCommand}"
                            Theme="{DynamicResource OutlineButton}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                <PathIcon Data="M5 12H19M15 8L19 12L15 16" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                <TextBlock Text="去除转义" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>

                <Border Grid.Row="1" Classes="tool-card-soft" MinHeight="0">
                    <avaloniaEdit:TextEditor
                        FontFamily="Consolas,monospace"
                        HorizontalScrollBarVisibility="Auto"
                        MinHeight="0"
                        Name="JsonText"
                        Padding="{StaticResource Thickness.8}"
                        behaviors:TextEditorBinding.Text="{Binding Original, Mode=TwoWay}"
                        ShowLineNumbers="True"
                        SyntaxHighlighting="Json"
                        VerticalScrollBarVisibility="Visible"
                        WordWrap="True">
                        <avaloniaEdit:TextEditor.Options>
                            <avaloniaEdit:TextEditorOptions ShowSpaces="False">
                                <avaloniaEdit:TextEditorOptions.ColumnRulerPositions>
                                    <system:Int32>10</system:Int32>
                                </avaloniaEdit:TextEditorOptions.ColumnRulerPositions>
                            </avaloniaEdit:TextEditorOptions>
                        </avaloniaEdit:TextEditor.Options>
                    </avaloniaEdit:TextEditor>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
