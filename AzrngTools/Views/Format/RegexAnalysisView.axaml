<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.Format.RegexAnalysisView"
    x:DataType="format:RegexAnalysisViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:format="clr-namespace:AzrngTools.ViewModels.Format"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：模式卡固定高度，测试/替换与四个结果区按 * 行撑满视口，文本框内部滚动 -->
    <Grid Margin="{StaticResource Thickness.15}" RowDefinitions="Auto,*,*" RowSpacing="{StaticResource Space.12}">
        <Border Grid.Row="0" Classes="tool-card-roomy">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Space.10}">
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="{StaticResource Space.8}">
                    <TextBox
                        Classes="Standard"
                        Text="{Binding RegexPattern}"
                        PlaceholderText="请输入正则表达式" />
                    <!-- 原「使用提示」卡压缩为一句提示，挂在说明图标上 -->
                    <Button
                        Grid.Column="1"
                        Classes="iconButton"
                        VerticalAlignment="Center"
                        ToolTip.Tip="匹配结果会用【】标出命中片段；替换结果单独展示，不会覆盖测试文本。">
                        <PathIcon
                            Data="M12 22C17.523 22 22 17.523 22 12C22 6.477 17.523 2 12 2C6.477 2 2 6.477 2 12C2 17.523 6.477 22 12 22ZM12 16V12M12 8H12.01"
                            Height="{StaticResource Layout.Icon.Sm}"
                            Width="{StaticResource Layout.Icon.Sm}" />
                    </Button>

                    <WrapPanel
                        Grid.Column="2"
                        Classes="tool-actions"
                        VerticalAlignment="Center">
                        <Button
                            Classes="actionIcon"
                            Command="{Binding TestRegexCommand}"
                            Content="开始匹配"
                            Tag="M4 5H20V19H4V5ZM8 9H16M8 13H13"
                            Theme="{DynamicResource SolidButton}" />
                        <Button
                            Classes="actionIcon"
                            Command="{Binding ReplaceTextCommand}"
                            Content="执行替换"
                            Tag="M4 7H17M13 3L17 7L13 11"
                            Theme="{DynamicResource SolidButton}" />
                        <Button
                            Classes="actionIcon"
                            Command="{Binding LoadExampleCommand}"
                            Content="加载示例"
                            Tag="M5 4H19V20H5V4ZM8 8H16M8 12H16M8 16H13"
                            Theme="{DynamicResource OutlineButton}" />
                        <Button
                            Classes="actionIcon"
                            Command="{Binding ClearCommand}"
                            Content="清空"
                            Tag="M5 7H19M9 7V5H15V7M8 10V17M12 10V17M16 10V17M7 7L8 20H16L17 7"
                            Theme="{DynamicResource OutlineButton}" />
                    </WrapPanel>
                </Grid>

                <Border Grid.Row="1" Classes="tool-card-soft">
                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="{StaticResource Space.12}">
                        <CheckBox Content="忽略大小写" IsChecked="{Binding IgnoreCase}" />
                        <CheckBox
                            Grid.Column="1"
                            Content="多行模式"
                            IsChecked="{Binding Multiline}" />
                        <CheckBox
                            Grid.Column="2"
                            Content="单行模式"
                            IsChecked="{Binding Singleline}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*"
            ColumnSpacing="{StaticResource Space.12}">
            <Border
                Grid.Column="0"
                Classes="tool-card-roomy"
                MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                    <TextBlock
                        Grid.Row="0"
                        Classes="section-copy"
                        Text="测试文本"
                        VerticalAlignment="Center" />

                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        Classes="Standard"
                        MinHeight="0"
                        Text="{Binding TestText}"
                        PlaceholderText="请输入测试文本" />
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Classes="tool-card-roomy"
                MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                    <TextBlock
                        Grid.Row="0"
                        Classes="section-copy"
                        Text="替换文本"
                        VerticalAlignment="Center" />

                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        Classes="Standard"
                        MinHeight="0"
                        Text="{Binding ReplacementText}"
                        PlaceholderText="请输入替换内容" />
                </Grid>
            </Border>
        </Grid>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*,*,*"
            ColumnSpacing="{StaticResource Space.12}">
            <Border
                Grid.Column="0"
                Classes="tool-card-roomy"
                MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                    <TextBlock
                        Grid.Row="0"
                        Classes="section-copy"
                        Text="高亮结果"
                        VerticalAlignment="Center" />

                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        Classes="Standard"
                        MinHeight="0"
                        IsReadOnly="True"
                        Text="{Binding HighlightedText}"
                        PlaceholderText="匹配结果会用【】标出" />
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Classes="tool-card-roomy"
                MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                    <TextBlock
                        Grid.Row="0"
                        Classes="section-copy"
                        Text="替换结果"
                        VerticalAlignment="Center" />

                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        Classes="Standard"
                        MinHeight="0"
                        IsReadOnly="True"
                        Text="{Binding ReplacedText}"
                        PlaceholderText="替换后的内容会显示在这里" />
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Classes="tool-card-roomy"
                MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                    <TextBlock
                        Grid.Row="0"
                        Classes="section-copy"
                        Text="匹配位置"
                        VerticalAlignment="Center" />

                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        Classes="Standard"
                        MinHeight="0"
                        IsReadOnly="True"
                        Text="{Binding MatchSummary}"
                        PlaceholderText="匹配位置和长度会显示在这里" />
                </Grid>
            </Border>

            <Border
                Grid.Column="3"
                Classes="tool-card-roomy"
                MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                    <TextBlock
                        Grid.Row="0"
                        Classes="section-copy"
                        Text="分组信息"
                        VerticalAlignment="Center" />

                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        Classes="Standard"
                        MinHeight="0"
                        IsReadOnly="True"
                        Text="{Binding GroupDetails}"
                        PlaceholderText="分组信息会显示在这里" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
