<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.Format.MimeQueryPageView"
    x:DataType="format:MimeQueryPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:format="clr-namespace:AzrngTools.ViewModels.Format"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：查询输入行固定高度，查询结果卡撑满剩余视口并在卡内滚动 -->
    <Grid Margin="{StaticResource Thickness.15}" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.12}">
        <Border Grid.Row="0" Classes="tool-card-roomy">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Space.10}">
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="{StaticResource Space.8}">
                    <TextBox
                        Classes="Standard"
                        Text="{Binding SearchText}"
                        PlaceholderText="请输入文件扩展名或 MIME 类型" />
                    <!-- 原「操作说明」卡压缩为一句提示，挂在说明图标上 -->
                    <Button
                        Grid.Column="1"
                        Classes="iconButton"
                        VerticalAlignment="Center"
                        ToolTip.Tip="按扩展名查询：输入 .jpg、png 等；按 MIME 类型查询：输入 image/、application/json 等片段模糊匹配。">
                        <PathIcon
                            Data="M12 22C17.523 22 22 17.523 22 12C22 6.477 17.523 2 12 2C6.477 2 2 6.477 2 12C2 17.523 6.477 22 12 22ZM12 16V12M12 8H12.01"
                            Height="{StaticResource Layout.Icon.Sm}"
                            Width="{StaticResource Layout.Icon.Sm}" />
                    </Button>
                </Grid>

                <WrapPanel Grid.Row="1" Classes="tool-actions">
                    <Button
                        Classes="actionIcon"
                        Command="{Binding QueryByExtensionCommand}"
                        Content="按扩展名查询"
                        Tag="M4 5H20V19H4V5ZM8 9H16M8 13H13"
                        Theme="{DynamicResource SolidButton}" />
                    <Button
                        Classes="actionIcon"
                        Command="{Binding QueryByMimeTypeCommand}"
                        Content="按MIME类型查询"
                        Tag="M4 5H20V19H4V5ZM8 9H16M8 13H13"
                        Theme="{DynamicResource SolidButton}" />
                    <Button
                        Classes="actionIcon"
                        Command="{Binding ShowAllMimeTypesCommand}"
                        Content="显示所有类型"
                        Tag="M5 4H19V20H5V4ZM8 8H16M8 12H16M8 16H13"
                        Theme="{DynamicResource OutlineButton}" />
                    <Button
                        Classes="actionIcon"
                        Command="{Binding CopyResultCommand}"
                        Content="复制结果"
                        Tag="M8 8H19V19H8V8ZM5 16H4V4H16V5"
                        Theme="{DynamicResource OutlineButton}" />
                    <Button
                        Classes="actionIcon"
                        Command="{Binding ClearCommand}"
                        Content="清空"
                        Tag="M5 7H19M9 7V5H15V7M8 10V17M12 10V17M16 10V17M7 7L8 20H16L17 7"
                        Theme="{DynamicResource OutlineButton}" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Classes="tool-card-roomy"
            MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                <TextBlock
                    Grid.Row="0"
                    Classes="section-copy"
                    Text="查询结果"
                    VerticalAlignment="Center" />

                <Border
                    Grid.Row="1"
                    Classes="tool-card-soft"
                    MinHeight="0">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            Classes="code-output"
                            FontFamily="Consolas,monospace"
                            Text="{Binding QueryResult}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
