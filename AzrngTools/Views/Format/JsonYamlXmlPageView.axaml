<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.Format.JsonYamlXmlPageView"
    x:DataType="format:JsonYamlXmlPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:format="clr-namespace:AzrngTools.ViewModels.Format"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:AzrngTools.Models.Format"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局样板：工作区(*)撑满视口 + 贴底状态细条(Auto，空闲隐藏)；
         编辑器随窗口拉伸，长内容在编辑器内部滚动 -->
    <Grid Margin="{StaticResource Thickness.15}" RowDefinitions="*,Auto" RowSpacing="{StaticResource Space.12}">
        <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.12}">
            <Border Grid.Column="0" Classes="tool-card-roomy" MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space.10}">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Space.8}">
                        <TextBlock
                            Classes="section-copy"
                            Text="源格式"
                            VerticalAlignment="Center" />
                        <u:EnumSelector
                            Grid.Column="1"
                            Width="140"
                            EnumType="{x:Type models:FormatLanguage}"
                            Value="{Binding SourceFormat}" />
                    </Grid>

                    <TextBox
                        Grid.Row="1"
                        Classes="Standard"
                        FontFamily="{DynamicResource Font.Family.Monospace}"
                        MinHeight="0"
                        PlaceholderText="请输入 JSON / YAML / XML 内容"
                        Text="{Binding SourceText}" />

                    <WrapPanel Grid.Row="2" Classes="tool-actions">
                        <Button
                            Classes="actionIcon Primary"
                            Command="{Binding ConvertCommand}"
                            Content="转换 →"
                            Tag="M4 7H17M13 3L17 7L13 11" />
                        <Button
                            Classes="actionIcon"
                            Command="{Binding FormatSourceCommand}"
                            Content="格式化"
                            Tag="M4 6H20M4 12H14M4 18H17" />
                        <Button
                            Classes="actionIcon"
                            Command="{Binding ValidateCommand}"
                            Content="校验"
                            Tag="M5 13L9 17L19 7" />
                        <Button
                            Classes="actionIcon"
                            Command="{Binding SwapCommand}"
                            Content="⇄ 交换"
                            Tag="M4 7H17M14 4L17 7L14 10M20 17H7M10 14L7 17L10 20" />
                        <Button
                            Classes="actionIcon"
                            Command="{Binding ClearCommand}"
                            Content="清空"
                            Tag="M6 7H18M9 7V5H15V7M8 7L9 19H15L16 7" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="tool-card-roomy" MinHeight="0">
                <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{StaticResource Space.8}">
                        <TextBlock
                            Classes="section-copy"
                            Text="目标格式"
                            VerticalAlignment="Center" />
                        <u:EnumSelector
                            Grid.Column="1"
                            Width="140"
                            EnumType="{x:Type models:FormatLanguage}"
                            Value="{Binding TargetFormat}" />
                        <Border
                            Grid.Column="3"
                            Classes="badge-pill"
                            VerticalAlignment="Center">
                            <TextBlock Classes="badge-text" Text="只读" />
                        </Border>
                    </Grid>

                    <TextBox
                        Grid.Row="1"
                        Classes="Standard"
                        FontFamily="{DynamicResource Font.Family.Monospace}"
                        IsReadOnly="True"
                        MinHeight="0"
                        PlaceholderText="转换结果"
                        Text="{Binding TargetText}" />
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="1"
            Classes="status-strip"
            Classes.error="{Binding !IsValidationSuccess}"
            Classes.success="{Binding IsValidationSuccess}"
            IsVisible="{Binding HasStatusMessage}">
            <TextBlock
                Classes="status-strip-text"
                Classes.error="{Binding !IsValidationSuccess}"
                Classes.success="{Binding IsValidationSuccess}"
                Text="{Binding ValidationMessage}"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
