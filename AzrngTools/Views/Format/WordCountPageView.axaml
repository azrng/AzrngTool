<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.Format.WordCountPageView"
    x:DataType="format:WordCountPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:format="clr-namespace:AzrngTools.ViewModels.Format"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：左侧输入卡与右侧统计结果卡各自撑满视口，统计内容超高时在卡内滚动 -->
    <Grid
        Margin="{StaticResource Thickness.15}"
        ColumnDefinitions="1.1*,0.9*"
        ColumnSpacing="{StaticResource Space.12}">
        <Border
            Grid.Column="0"
            Classes="tool-card-roomy"
            MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space.10}">
                <TextBlock
                    Grid.Row="0"
                    Classes="section-copy"
                    Text="输入文本"
                    VerticalAlignment="Center" />

                <TextBox
                    Grid.Row="1"
                    AcceptsReturn="True"
                    Classes="Standard"
                    MinHeight="0"
                    Text="{Binding InputText}"
                    TextWrapping="Wrap"
                    PlaceholderText="请输入要统计的文本..." />

                <WrapPanel Grid.Row="2" Classes="tool-actions">
                    <Button
                        Classes="actionIcon"
                        Command="{Binding CountWordsCommand}"
                        Content="统计字数"
                        Tag="M4 5H20V19H4V5ZM8 9H16M8 13H13"
                        Theme="{DynamicResource SolidButton}" />
                    <Button
                        Classes="actionIcon"
                        Command="{Binding CopyResultCommand}"
                        Content="复制统计结果"
                        Tag="M8 8H19V19H8V8ZM5 16H4V4H16V5"
                        Theme="{DynamicResource OutlineButton}" />
                    <Button
                        Classes="actionIcon"
                        Command="{Binding ClearCommand}"
                        Content="清空"
                        Tag="M5 7H19M9 7V5H15V7M8 10V17M12 10V17M16 10V17M7 7L8 20H16L17 7"
                        Theme="{DynamicResource OutlineButton}" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Classes="tool-card-roomy"
            MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="{StaticResource Space.8}">
                    <TextBlock
                        Classes="section-copy"
                        Text="统计结果"
                        VerticalAlignment="Center" />
                    <!-- 原「使用提示」卡压缩为一句提示，挂在说明图标上 -->
                    <Button
                        Grid.Column="1"
                        Classes="iconButton"
                        ToolTip.Tip="空文本会重置统计结果；英文词数按空白和标点分割；复制按钮会导出完整统计摘要。">
                        <PathIcon
                            Data="M12 22C17.523 22 22 17.523 22 12C22 6.477 17.523 2 12 2C6.477 2 2 6.477 2 12C2 17.523 6.477 22 12 22ZM12 16V12M12 8H12.01"
                            Height="{StaticResource Layout.Icon.Sm}"
                            Width="{StaticResource Layout.Icon.Sm}" />
                    </Button>
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    MinHeight="0"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="{StaticResource Space.12}">
                        <Border Classes="tool-card-soft">
                            <StackPanel Spacing="{StaticResource Space.8}">
                                <TextBlock Classes="metric-label" Text="基础统计" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section-copy" Text="总字符数" />
                                    <TextBlock Grid.Column="1" Classes="metric-value" Text="{Binding TotalCharacters}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section-copy" Text="中文字符数" />
                                    <TextBlock Grid.Column="1" Classes="metric-value" Text="{Binding ChineseCharacters}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section-copy" Text="英文字符数" />
                                    <TextBlock Grid.Column="1" Classes="metric-value" Text="{Binding EnglishCharacters}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section-copy" Text="数字数量" />
                                    <TextBlock Grid.Column="1" Classes="metric-value" Text="{Binding Numbers}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section-copy" Text="标点符号" />
                                    <TextBlock Grid.Column="1" Classes="metric-value" Text="{Binding Punctuation}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="tool-card-soft">
                            <StackPanel Spacing="{StaticResource Space.8}">
                                <TextBlock Classes="metric-label" Text="格式统计" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section-copy" Text="空格数量" />
                                    <TextBlock Grid.Column="1" Classes="metric-value" Text="{Binding Spaces}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section-copy" Text="行数" />
                                    <TextBlock Grid.Column="1" Classes="metric-value" Text="{Binding Lines}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section-copy" Text="英文词数" />
                                    <TextBlock Grid.Column="1" Classes="metric-value" Text="{Binding Words}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section-copy" Text="段落数" />
                                    <TextBlock Grid.Column="1" Classes="metric-value" Text="{Binding Paragraphs}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
