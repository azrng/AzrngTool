<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.Format.SqlFormatPageView"
    x:DataType="vm:SqlFormatPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
    xmlns:behaviors="clr-namespace:AzrngTools.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:vm="using:AzrngTools.ViewModels.Format"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：单编辑区撑满视口，编辑器内部滚动，操作按钮集中在编辑卡底部 -->
    <Border Margin="{StaticResource Thickness.15}" Classes="tool-card-roomy" MinHeight="0">
        <Grid MinHeight="0" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space.10}">
            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="{StaticResource Space.8}">
                <TextBlock
                    Classes="section-copy"
                    Text="编辑区"
                    VerticalAlignment="Center" />
                <!-- 原右侧「操作说明」卡压缩为一句提示，挂在说明图标上 -->
                <Button
                    Grid.Column="1"
                    Classes="iconButton"
                    ToolTip.Tip="所有操作都直接作用于当前编辑器内容并原地回写；建议顺序：SQL 格式化 → 转义 / 去除转义 → SQL 压缩。">
                    <PathIcon
                        Data="M12 22C17.523 22 22 17.523 22 12C22 6.477 17.523 2 12 2C6.477 2 2 6.477 2 12C2 17.523 6.477 22 12 22ZM12 16V12M12 8H12.01"
                        Height="{StaticResource Layout.Icon.Sm}"
                        Width="{StaticResource Layout.Icon.Sm}" />
                </Button>
            </Grid>

            <Border
                Grid.Row="1"
                Classes="tool-card-soft"
                MinHeight="0">
                <avaloniaEdit:TextEditor
                    FontFamily="Consolas,monospace"
                    HorizontalScrollBarVisibility="Auto"
                    MinHeight="0"
                    Name="JsonText"
                    Padding="{StaticResource Thickness.8}"
                    behaviors:TextEditorBinding.Text="{Binding OriginText, Mode=TwoWay}"
                    ShowLineNumbers="True"
                    SyntaxHighlighting="SQL"
                    VerticalScrollBarVisibility="Visible"
                    WordWrap="True">
                    <avaloniaEdit:TextEditor.Options>
                        <avaloniaEdit:TextEditorOptions ShowSpaces="False">
                            <avaloniaEdit:TextEditorOptions.ColumnRulerPositions>
                                <system:Int32>10</system:Int32>
                            </avaloniaEdit:TextEditorOptions.ColumnRulerPositions>
                        </avaloniaEdit:TextEditorOptions>
                    </avaloniaEdit:TextEditor.Options>
                </avaloniaEdit:TextEditor>
            </Border>

            <WrapPanel Grid.Row="2" Classes="tool-actions">
                <Button
                    Classes="actionIcon"
                    Command="{Binding EscapeJsonCommand}"
                    CommandParameter="false"
                    Content="转义"
                    Tag="M4 7H17M13 3L17 7L13 11"
                    Theme="{DynamicResource SolidButton}" />
                <Button
                    Classes="actionIcon"
                    Command="{Binding ReplaceEscapeCommand}"
                    CommandParameter="0"
                    Content="去除转义"
                    Tag="M7 13L3 17L7 21M3 17H16"
                    Theme="{DynamicResource OutlineButton}" />
                <Button
                    Classes="actionIcon"
                    Command="{Binding SqlCompressCommand}"
                    CommandParameter="0"
                    Content="SQL 压缩"
                    Tag="M4 5H20V19H4V5ZM8 9H16M8 13H13"
                    Theme="{DynamicResource OutlineButton}" />
                <Button
                    Classes="actionIcon"
                    Command="{Binding SqlFormatCommand}"
                    CommandParameter="0"
                    Content="SQL 格式化"
                    Tag="M5 4H19V20H5V4ZM8 8H16M8 12H16M8 16H13"
                    Theme="{DynamicResource SolidButton}" />
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
