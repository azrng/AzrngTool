<UserControl
    d:DesignHeight="980"
    d:DesignWidth="1320"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.Network.ApiRequestPageView"
    x:DataType="vm:ApiRequestPageViewModel"
    x:Name="RootPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AzrngTools.ViewModels.Network"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="TextBlock.api-request-status-inline">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.api-request-empty">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel.SubtleBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Panel.Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
            <Setter Property="Padding" Value="{StaticResource Thickness.15}" />
        </Style>

        <Style Selector="Border.api-request-history-item">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Panel.Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
            <Setter Property="Padding" Value="{StaticResource Thickness.12}" />
        </Style>

        <Style Selector="Border.api-request-response-success">
            <Setter Property="Background" Value="{DynamicResource Brush.Status.Success.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Success.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
            <Setter Property="Padding" Value="{StaticResource Thickness.10.4}" />
        </Style>

        <Style Selector="Border.api-request-response-warning">
            <Setter Property="Background" Value="{DynamicResource Brush.Status.Warning.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Warning.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
            <Setter Property="Padding" Value="{StaticResource Thickness.10.4}" />
        </Style>

        <Style Selector="Border.api-request-response-error">
            <Setter Property="Background" Value="{DynamicResource Brush.Status.Error.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Error.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
            <Setter Property="Padding" Value="{StaticResource Thickness.10.4}" />
        </Style>

        <Style Selector="TextBlock.api-request-response-success-text">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Success.Text}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.api-request-response-warning-text">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Warning.Text}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.api-request-response-error-text">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Error.Text}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="{StaticResource Thickness.15}" RowDefinitions="Auto" RowSpacing="{StaticResource Space.12}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.12}">
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource Space.12}">
                <Border Grid.Row="0" Classes="tool-card-roomy">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Space.10}">
                        <Grid ColumnDefinitions="130,*,Auto" ColumnSpacing="{StaticResource Space.10}">
                            <ComboBox
                                Grid.Column="0"
                                IsEnabled="{Binding IsRequestInFlight, Converter={StaticResource InvertedBoolConverter}}"
                                ItemsSource="{Binding HttpMethods}"
                                SelectedItem="{Binding SelectedMethod}" />

                            <TextBox
                                Grid.Column="1"
                                IsEnabled="{Binding IsRequestInFlight, Converter={StaticResource InvertedBoolConverter}}"
                                PlaceholderText="输入请求地址，例如 https://api.example.com/users?id=1"
                                Text="{Binding RequestUrl}" />

                            <Button
                                Grid.Column="2"
                                Command="{Binding SendRequestCommand}"
                                IsVisible="{Binding IsRequestInFlight, Converter={StaticResource InvertedBoolConverter}}"
                                Theme="{DynamicResource SolidButton}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                    <PathIcon Data="M4 12L20 4L14 20L11 13L4 12ZM11 13L20 4" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                    <TextBlock Text="发送请求" />
                                </StackPanel>
                            </Button>

                            <Button
                                Grid.Column="2"
                                Command="{Binding CancelRequestCommand}"
                                IsVisible="{Binding IsRequestInFlight}"
                                Theme="{DynamicResource OutlineButton}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                    <PathIcon Data="M6 6L18 18M18 6L6 18" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                    <TextBlock Text="取消请求" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource Space.10}">
                            <TextBlock Classes="section-title" Text="接口调试工作台" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="metric-label" Text="可按需配置查询参数、请求头与请求体" VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="2"
                                Classes="api-request-status-inline"
                                MaxWidth="220"
                                Text="{Binding StatusMessage}"
                                ToolTip.Tip="{Binding StatusMessage}" />
                            <WrapPanel Grid.Column="3" Classes="tool-actions" HorizontalAlignment="Right">
                                <Button
                                    Command="{Binding ClearCurrentRequestCommand}"
                                    IsEnabled="{Binding IsRequestInFlight, Converter={StaticResource InvertedBoolConverter}}"
                                    Theme="{DynamicResource OutlineButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                        <PathIcon Data="M5 7H19M9 7V5H15V7M8 10V17M12 10V17M16 10V17M7 7L8 20H16L17 7" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                        <TextBlock Text="清空当前" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Command="{Binding ToggleHistoryPaneCommand}"
                                    IsEnabled="{Binding IsRequestInFlight, Converter={StaticResource InvertedBoolConverter}}"
                                    Theme="{DynamicResource OutlineButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                        <PathIcon Data="M4 5H20V19H4V5ZM8 9H16M8 13H13" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                        <TextBlock Text="{Binding HistoryPaneToggleText}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Classes="tool-card-roomy">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Space.10}">
                        <StackPanel Spacing="{StaticResource Space.4}">
                            <TextBlock Classes="section-title" Text="请求配置" />
                            <TextBlock Classes="section-copy" Text="参数、Header 和 Body 分区拆开，便于逐块核对输入并快速回放历史请求。" />
                        </StackPanel>

                        <TabControl
                            Grid.Row="1"
                            IsEnabled="{Binding IsRequestInFlight, Converter={StaticResource InvertedBoolConverter}}"
                            SelectedIndex="{Binding SelectedConfigTabIndex}">
                            <TabItem Header="Params">
                                <Grid Margin="{StaticResource Thickness.12}" RowDefinitions="Auto" RowSpacing="{StaticResource Space.12}">
                                    <Border Classes="tool-card-soft">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Space.8}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.8}">
                                                <TextBlock Classes="section-title" Text="Query 参数" />
                                                <Button
                                                    Grid.Column="1"
                                                    Command="{Binding AddQueryParameterCommand}"
                                                    Theme="{DynamicResource OutlineButton}"
                                                    ToolTip.Tip="添加查询参数">
                                                    <PathIcon Data="M12 4V20M4 12H20" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                                </Button>
                                            </Grid>

                                            <Border Grid.Row="1" Classes="tool-card-subtle">
                                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="{StaticResource Space.8}">
                                                    <TextBlock Classes="metric-label" Text="参数名" />
                                                    <TextBlock Grid.Column="1" Classes="metric-label" Text="参数值" />
                                                </Grid>
                                            </Border>

                                            <TextBlock
                                                Grid.Row="2"
                                                Classes="section-copy"
                                                IsVisible="{Binding QueryParameters.Count, Converter={StaticResource EqualToZeroConverter}}"
                                                Text="暂无查询参数，点击右上角加号添加一行。" />

                                            <ItemsControl
                                                Grid.Row="3"
                                                IsVisible="{Binding QueryParameters.Count, Converter={StaticResource GreaterThanZeroConverter}}"
                                                ItemsSource="{Binding QueryParameters}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ApiRequestParameterItemViewModel">
                                                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="{StaticResource Space.8}" Margin="{StaticResource Thickness.Top.2}">
                                                            <TextBox Grid.Column="0" PlaceholderText="name" Text="{Binding Name}" />
                                                            <TextBox Grid.Column="1" PlaceholderText="value" Text="{Binding Value}" />
                                                            <Button
                                                                Grid.Column="2"
                                                                Command="{ReflectionBinding #RootPage.DataContext.RemoveParameterCommand}"
                                                                CommandParameter="{Binding}"
                                                                Theme="{DynamicResource OutlineButton}"
                                                                ToolTip.Tip="删除参数">
                                                                <PathIcon Data="M5 7H19M9 7V5H15V7M8 10V17M12 10V17M16 10V17M7 7L8 20H16L17 7" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Headers">
                                <Grid Margin="{StaticResource Thickness.12}" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Space.8}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.8}">
                                        <TextBlock Classes="section-title" Text="请求头" />
                                        <Button
                                            Grid.Column="1"
                                            Command="{Binding AddHeaderCommand}"
                                            Theme="{DynamicResource OutlineButton}"
                                            ToolTip.Tip="添加请求头">
                                            <PathIcon Data="M12 4V20M4 12H20" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                        </Button>
                                    </Grid>

                                    <Border Grid.Row="1" Classes="tool-card-subtle">
                                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="{StaticResource Space.8}">
                                            <TextBlock Classes="metric-label" Text="Header 名" />
                                            <TextBlock Grid.Column="1" Classes="metric-label" Text="Header 值" />
                                        </Grid>
                                    </Border>

                                    <TextBlock
                                        Grid.Row="2"
                                        Classes="section-copy"
                                        IsVisible="{Binding Headers.Count, Converter={StaticResource EqualToZeroConverter}}"
                                        Text="暂无请求头，点击右上角加号添加一行。" />

                                    <ItemsControl
                                        Grid.Row="3"
                                        IsVisible="{Binding Headers.Count, Converter={StaticResource GreaterThanZeroConverter}}"
                                        ItemsSource="{Binding Headers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ApiRequestParameterItemViewModel">
                                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="{StaticResource Space.8}" Margin="{StaticResource Thickness.Top.2}">
                                                    <TextBox Grid.Column="0" PlaceholderText="Authorization" Text="{Binding Name}" />
                                                    <TextBox Grid.Column="1" PlaceholderText="Bearer token" Text="{Binding Value}" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Command="{ReflectionBinding #RootPage.DataContext.RemoveParameterCommand}"
                                                        CommandParameter="{Binding}"
                                                        Theme="{DynamicResource OutlineButton}"
                                                        ToolTip.Tip="删除请求头">
                                                        <PathIcon Data="M5 7H19M9 7V5H15V7M8 10V17M12 10V17M16 10V17M7 7L8 20H16L17 7" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Body">
                                <Grid Margin="{StaticResource Thickness.12}" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Space.10}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.10}">
                                        <TextBlock Classes="metric-label" Text="Body 模式" VerticalAlignment="Center" />
                                        <ComboBox
                                            Grid.Column="1"
                                            ItemsSource="{Binding BodyModeOptions}"
                                            SelectedItem="{Binding SelectedBodyModeOption}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ApiRequestBodyModeOptionViewModel">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <CheckBox
                                        Grid.Row="1"
                                        Content="忽略 SSL 证书错误"
                                        IsChecked="{Binding IgnoreSslErrors}" />

                                    <Border Grid.Row="2" Classes="tool-card-soft" IsVisible="{Binding IsFormBodyMode}">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Space.8}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.8}">
                                                <TextBlock Classes="section-title" Text="表单字段" />
                                                <Button
                                                    Grid.Column="1"
                                                    Command="{Binding AddFormFieldCommand}"
                                                    Theme="{DynamicResource OutlineButton}"
                                                    ToolTip.Tip="添加表单字段">
                                                    <PathIcon Data="M12 4V20M4 12H20" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                                </Button>
                                            </Grid>

                                            <Border Grid.Row="1" Classes="tool-card-subtle">
                                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="{StaticResource Space.8}">
                                                    <TextBlock Classes="metric-label" Text="字段名" />
                                                    <TextBlock Grid.Column="1" Classes="metric-label" Text="字段值" />
                                                </Grid>
                                            </Border>

                                            <TextBlock
                                                Grid.Row="2"
                                                Classes="section-copy"
                                                IsVisible="{Binding FormFields.Count, Converter={StaticResource EqualToZeroConverter}}"
                                                Text="暂无表单字段，点击右上角加号添加一行。" />

                                            <ItemsControl
                                                Grid.Row="3"
                                                IsVisible="{Binding FormFields.Count, Converter={StaticResource GreaterThanZeroConverter}}"
                                                ItemsSource="{Binding FormFields}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ApiRequestParameterItemViewModel">
                                                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="{StaticResource Space.8}" Margin="{StaticResource Thickness.Top.2}">
                                                            <TextBox Grid.Column="0" PlaceholderText="name" Text="{Binding Name}" />
                                                            <TextBox Grid.Column="1" PlaceholderText="value" Text="{Binding Value}" />
                                                            <Button
                                                                Grid.Column="2"
                                                                Command="{ReflectionBinding #RootPage.DataContext.RemoveParameterCommand}"
                                                                CommandParameter="{Binding}"
                                                                Theme="{DynamicResource OutlineButton}"
                                                                ToolTip.Tip="删除表单字段">
                                                                <PathIcon Data="M5 7H19M9 7V5H15V7M8 10V17M12 10V17M16 10V17M7 7L8 20H16L17 7" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>

                                    <TextBox
                                        Grid.Row="3"
                                        AcceptsReturn="True"
                                        Classes="Standard"
                                        MinHeight="{StaticResource Layout.Editor.Md}"
                                        IsVisible="{Binding HasRawBodyEditor}"
                                        PlaceholderText="{Binding RequestBodyPlaceholder}"
                                        Text="{Binding RequestBody}"
                                        TextWrapping="NoWrap" />
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Classes="tool-card-roomy">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Space.10}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.10}">
                            <StackPanel Spacing="{StaticResource Space.4}">
                                <TextBlock Classes="section-title" Text="响应结果" />
                                <TextBlock Classes="section-copy" Text="状态、耗时、大小和响应内容会在这里集中展示。" />
                            </StackPanel>

                            <WrapPanel Grid.Column="1" Classes="tool-actions" HorizontalAlignment="Right">
                                <Button
                                    Command="{Binding CopyResponseBodyCommand}"
                                    IsEnabled="{Binding HasResponse}"
                                    Theme="{DynamicResource OutlineButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                        <PathIcon Data="M8 8H19V19H8V8ZM5 16H4V5H15V6" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                        <TextBlock Text="复制响应体" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Command="{Binding CopyResponseHeadersCommand}"
                                    IsEnabled="{Binding HasResponse}"
                                    Theme="{DynamicResource OutlineButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                        <PathIcon Data="M8 8H19V19H8V8ZM5 16H4V5H15V6" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                        <TextBlock Text="复制响应头" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <Border Grid.Row="1" Classes="tool-card-soft" IsVisible="{Binding IsRequestInFlight}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space.10}">
                                <ProgressBar
                                    Grid.Column="0"
                                    Width="28"
                                    Height="18"
                                    IsIndeterminate="True"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="1"
                                    Classes="section-copy"
                                    Text="{Binding RequestLoadingText}"
                                    VerticalAlignment="Center" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding CancelRequestCommand}"
                                    Theme="{DynamicResource OutlineButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                        <PathIcon Data="M6 6L18 18M18 6L6 18" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                        <TextBlock Text="取消" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <WrapPanel Grid.Row="2" Classes="tool-actions" IsVisible="{Binding HasResponse}">
                            <Border Classes="api-request-response-success" IsVisible="{Binding IsResponseSuccess}">
                                <TextBlock Classes="api-request-response-success-text" Text="{Binding ResponseStatusText}" />
                            </Border>
                            <Border Classes="api-request-response-warning" IsVisible="{Binding IsResponseWarning}">
                                <TextBlock Classes="api-request-response-warning-text" Text="{Binding ResponseStatusText}" />
                            </Border>
                            <Border Classes="api-request-response-error" IsVisible="{Binding IsResponseError}">
                                <TextBlock Classes="api-request-response-error-text" Text="{Binding ResponseStatusText}" />
                            </Border>
                            <Border Classes="badge-pill compact">
                                <TextBlock Classes="badge-text" Text="{Binding ResponseDurationText}" />
                            </Border>
                            <Border Classes="badge-pill compact">
                                <TextBlock Classes="badge-text" Text="{Binding ResponseSizeText}" />
                            </Border>
                        </WrapPanel>

                        <Border Grid.Row="3" Classes="api-request-empty" IsVisible="{Binding ShowResponsePlaceholderCard}">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource Space.8}">
                                <TextBlock Classes="metric-label" Text="等待响应" />
                                <TextBlock Grid.Row="1" Classes="section-copy" Text="发送一个请求后，响应体、请求 URL 和响应头会出现在这里。" />
                                <Button
                                    Grid.Row="2"
                                    Command="{Binding SendRequestCommand}"
                                    HorizontalAlignment="Left"
                                    Theme="{DynamicResource SolidButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                        <PathIcon Data="M4 12L20 4L14 20L11 13L4 12ZM11 13L20 4" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                        <TextBlock Text="发送请求" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <TabControl Grid.Row="3" IsVisible="{Binding HasResponse}" SelectedIndex="{Binding SelectedResponseTabIndex}">
                            <TabItem Header="响应体">
                                <TextBox
                                    AcceptsReturn="True"
                                    Classes="Standard"
                                    MinHeight="{StaticResource Layout.Editor.Lg}"
                                    IsReadOnly="True"
                                    PlaceholderText="响应体会显示在这里"
                                    Text="{Binding ResponseBodyText}"
                                    TextWrapping="Wrap" />
                            </TabItem>
                            <TabItem Header="请求 URL">
                                <TextBox
                                    AcceptsReturn="True"
                                    Classes="Standard"
                                    MinHeight="{StaticResource Layout.Editor.Lg}"
                                    IsReadOnly="True"
                                    PlaceholderText="完整请求 URL 会显示在这里"
                                    Text="{Binding ResponseRequestUrlText}"
                                    TextWrapping="Wrap" />
                            </TabItem>
                            <TabItem Header="响应头">
                                <TextBox
                                    AcceptsReturn="True"
                                    Classes="Standard"
                                    MinHeight="{StaticResource Layout.Editor.Lg}"
                                    IsReadOnly="True"
                                    PlaceholderText="响应头会显示在这里"
                                    Text="{Binding ResponseHeadersText}"
                                    TextWrapping="Wrap" />
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1" Classes="tool-card-roomy" IsVisible="{Binding IsHistoryPaneOpen}" Width="340" x:Name="HistoryPane">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{StaticResource Space.10}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.10}">
                        <StackPanel Spacing="{StaticResource Space.4}">
                            <TextBlock Classes="section-title" Text="请求历史" />
                            <TextBlock Classes="section-copy" Text="发送成功或失败后的请求都会保存在本地，方便切换、回放和继续调试。" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Command="{Binding ToggleHistoryPaneCommand}"
                            Theme="{DynamicResource OutlineButton}">
                            <PathIcon Data="M6 6L18 18M18 6L6 18" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1" Classes="metric-label" Text="{Binding HistorySummaryText}" />

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.10}">
                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="搜索方法、地址或状态"
                            Text="{Binding HistorySearchText}" />

                        <Button
                            Grid.Column="1"
                            Command="{Binding ClearHistoryCommand}"
                            Theme="{DynamicResource OutlineButton}"
                            ToolTip.Tip="清空请求历史">
                            <PathIcon Data="M5 7H19M9 7V5H15V7M8 10V17M12 10V17M16 10V17M7 7L8 20H16L17 7" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="3" Classes="api-request-empty" IsVisible="{Binding ShowHistoryEmptyPlaceholder}">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource Space.8}">
                            <TextBlock Classes="metric-label" Text="还没有请求历史" />
                            <TextBlock Grid.Row="1" Classes="section-copy" Text="发送一次请求后，记录会自动保存在本机，方便回放。" />
                            <Button
                                Grid.Row="2"
                                Command="{Binding SendRequestCommand}"
                                HorizontalAlignment="Left"
                                Theme="{DynamicResource SolidButton}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                    <PathIcon Data="M5 12H19M15 8L19 12L15 16" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                    <TextBlock Text="发送当前请求" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasHistoryItems}" MinHeight="0" VerticalScrollBarVisibility="Auto" x:Name="HistoryScrollViewer">
                        <ItemsControl ItemsSource="{Binding HistoryItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ApiRequestHistoryItemViewModel">
                                    <Border Classes="api-request-history-item" Margin="{StaticResource Thickness.Bottom.10}">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource Space.8}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space.8}">
                                                <Border Classes="badge-pill compact">
                                                    <TextBlock Classes="badge-text" Text="{Binding Method}" />
                                                </Border>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    Classes="section-copy"
                                                    Text="{Binding Url}"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />

                                                <TextBlock
                                                    Grid.Column="2"
                                                    Classes="metric-label"
                                                    Text="{Binding TimestampText}"
                                                    VerticalAlignment="Center" />
                                            </Grid>

                                            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="{StaticResource Space.10}">
                                                <StackPanel Spacing="{StaticResource Space.2}">
                                                    <TextBlock Classes="metric-label" Text="状态" />
                                                    <TextBlock Classes="metric-value" Text="{Binding StatusText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="{StaticResource Space.2}">
                                                    <TextBlock Classes="metric-label" Text="耗时" />
                                                    <TextBlock Classes="metric-value" Text="{Binding DurationText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="{StaticResource Space.2}">
                                                    <TextBlock Classes="metric-label" Text="大小" />
                                                    <TextBlock Classes="metric-value" Text="{Binding SizeText}" />
                                                </StackPanel>
                                            </Grid>

                                            <WrapPanel Grid.Row="2" Classes="tool-actions">
                                                <Button
                                                    Command="{ReflectionBinding #RootPage.DataContext.LoadHistoryItemCommand}"
                                                    CommandParameter="{Binding}"
                                                    Theme="{DynamicResource OutlineButton}"
                                                    ToolTip.Tip="载入请求">
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                                        <PathIcon Data="M5 12H19M15 8L19 12L15 16" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                                        <TextBlock Text="载入" />
                                                    </StackPanel>
                                                </Button>
                                                <Button
                                                    Command="{ReflectionBinding #RootPage.DataContext.DeleteHistoryItemCommand}"
                                                    CommandParameter="{Binding}"
                                                    Theme="{DynamicResource OutlineButton}"
                                                    ToolTip.Tip="删除请求历史">
                                                    <PathIcon Data="M5 7H19M9 7V5H15V7M8 10V17M12 10V17M16 10V17M7 7L8 20H16L17 7" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                                </Button>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
