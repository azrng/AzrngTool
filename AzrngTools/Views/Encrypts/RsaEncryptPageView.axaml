<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.Encrypts.RsaEncryptPageView"
    x:DataType="vm:RsaEncryptPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:AzrngTools.Utils"
    xmlns:vm="using:AzrngTools.ViewModels.Encrypts"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：单卡撑满视口，保留“加解密”“生成密钥”两个页签；
         编辑器随窗口拉伸并在内部滚动 -->
    <Grid Margin="{StaticResource Thickness.15}" RowDefinitions="*">
        <Border Grid.Row="0" Classes="tool-card-roomy" MinHeight="0">
            <TabControl MinHeight="0">
                <TabItem Header="加解密">
                    <Grid
                        Margin="{StaticResource Thickness.10}"
                        MinHeight="0"
                        RowDefinitions="Auto,1.2*,Auto,1*"
                        RowSpacing="{StaticResource Space.10}">
                        <!-- 参数行：密钥类型 / 输入输出类型，必要约束挂在小图标提示上 -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="{StaticResource Space.8}">
                            <TextBlock Classes="metric-label" Text="密钥类型" VerticalAlignment="Center" />
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="140"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding Source={x:Static utils:EnumValuesHelper.RSAKeyTypeValues}}"
                                SelectedIndex="{Binding RsaKeyTypeValue}" />
                            <TextBlock
                                Grid.Column="2"
                                Classes="metric-label"
                                Margin="{StaticResource Thickness.Right.10}"
                                Text="输入输出类型"
                                VerticalAlignment="Center" />
                            <ComboBox
                                Grid.Column="3"
                                MinWidth="140"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding Source={x:Static utils:EnumValuesHelper.OutTypeValues}}"
                                SelectedIndex="{Binding OutTypeValue}" />
                            <Button
                                Grid.Column="5"
                                Classes="iconButton"
                                ToolTip.Tip="密钥类型需与所用公私钥格式匹配；输入输出类型同时影响加密输出与解密输入的解释方式。"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Data="M12 8H12.01M12 12V16M21 12A9 9 0 1 1 3 12A9 9 0 0 1 21 12Z"
                                    Height="{StaticResource Layout.Icon.Sm}"
                                    Width="{StaticResource Layout.Icon.Sm}" />
                            </Button>
                        </Grid>

                        <!-- 原文 / 处理结果左右两列 -->
                        <Grid Grid.Row="1" MinHeight="0" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.12}">
                            <Grid Grid.Column="0" MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.6}">
                                <TextBlock Classes="metric-label" Text="原文" />
                                <TextBox
                                    Grid.Row="1"
                                    AcceptsReturn="True"
                                    Classes="Standard"
                                    MinHeight="0"
                                    PlaceholderText="请输入要加密或解密的内容"
                                    Text="{Binding Original}" />
                            </Grid>

                            <Grid Grid.Column="1" MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.6}">
                                <TextBlock Classes="metric-label" Text="处理结果" />
                                <TextBox
                                    Grid.Row="1"
                                    AcceptsReturn="True"
                                    Classes="Standard"
                                    MinHeight="0"
                                    IsReadOnly="True"
                                    PlaceholderText="加密或解密的结果"
                                    Text="{Binding Ciphertext}" />
                            </Grid>
                        </Grid>

                        <WrapPanel Grid.Row="2" Classes="tool-actions">
                            <Button Classes="actionIcon" Command="{Binding EncryptHandlerCommand}" CommandParameter="0" Content="加密" Tag="M4 7H17M13 3L17 7L13 11" Theme="{DynamicResource SolidButton}" />
                            <Button Classes="actionIcon" Command="{Binding EncryptHandlerCommand}" CommandParameter="1" Content="解密" Tag="M7 13L3 17L7 21M3 17H16" Theme="{DynamicResource OutlineButton}" />
                        </WrapPanel>

                        <!-- 公钥 / 私钥左右两列 -->
                        <Grid Grid.Row="3" MinHeight="0" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.12}">
                            <Grid Grid.Column="0" MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.6}">
                                <TextBlock Classes="metric-label" Text="公钥（加密用）" />
                                <TextBox
                                    Grid.Row="1"
                                    AcceptsReturn="True"
                                    Classes="Standard"
                                    MinHeight="0"
                                    PlaceholderText="请输入公钥"
                                    Text="{Binding PublicKey}" />
                            </Grid>

                            <Grid Grid.Column="1" MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.6}">
                                <TextBlock Classes="metric-label" Text="私钥（解密用）" />
                                <TextBox
                                    Grid.Row="1"
                                    AcceptsReturn="True"
                                    Classes="Standard"
                                    MinHeight="0"
                                    PlaceholderText="请输入私钥"
                                    Text="{Binding PrivateKey}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="生成密钥">
                    <Grid
                        Margin="{StaticResource Thickness.10}"
                        MinHeight="0"
                        RowDefinitions="Auto,*"
                        RowSpacing="{StaticResource Space.10}">
                        <WrapPanel Grid.Row="0" Classes="tool-actions">
                            <ComboBox
                                MinWidth="140"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding Source={x:Static utils:EnumValuesHelper.RSAKeyTypeValues}}"
                                SelectedIndex="{Binding RsaKeyTypeValue}" />
                            <Button
                                Classes="actionIcon"
                                Command="{Binding GenerateSecretCommand}"
                                Content="生成公私钥"
                                Tag="M12 4V20M4 12H20"
                                Theme="{DynamicResource SolidButton}" />
                        </WrapPanel>

                        <!-- 生成结果左右两列，与“加解密”页签共用同一组绑定 -->
                        <Grid Grid.Row="1" MinHeight="0" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.12}">
                            <Grid Grid.Column="0" MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.6}">
                                <TextBlock Classes="metric-label" Text="公钥输出" />
                                <TextBox
                                    Grid.Row="1"
                                    AcceptsReturn="True"
                                    Classes="Standard"
                                    MinHeight="0"
                                    PlaceholderText="公钥"
                                    Text="{Binding PublicKey}" />
                            </Grid>

                            <Grid Grid.Column="1" MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.6}">
                                <TextBlock Classes="metric-label" Text="私钥输出" />
                                <TextBox
                                    Grid.Row="1"
                                    AcceptsReturn="True"
                                    Classes="Standard"
                                    MinHeight="0"
                                    PlaceholderText="私钥"
                                    Text="{Binding PrivateKey}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
