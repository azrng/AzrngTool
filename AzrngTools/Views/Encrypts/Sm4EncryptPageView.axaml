<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.Encrypts.Sm4EncryptPageView"
    x:DataType="vm:Sm4EncryptPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:AzrngTools.Utils"
    xmlns:vm="using:AzrngTools.ViewModels.Encrypts"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：左列原文编辑器+操作，右列密钥与只读结果，双列撑满视口；
         编辑器随窗口拉伸并在内部滚动 -->
    <Grid Margin="{StaticResource Thickness.15}" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.12}">
        <!-- 左列：原文与操作 -->
        <Border Grid.Column="0" Classes="tool-card-roomy" MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space.10}">
                <TextBlock
                    Grid.Row="0"
                    Classes="section-copy"
                    Text="原文"
                    VerticalAlignment="Center" />

                <TextBox
                    Grid.Row="1"
                    AcceptsReturn="True"
                    Classes="Standard"
                    MinHeight="0"
                    PlaceholderText="请输入要加密或解密的内容"
                    Text="{Binding Original}" />

                <WrapPanel Grid.Row="2" Classes="tool-actions">
                    <Button
                        Classes="actionIcon"
                        Command="{Binding Sm4HandlerCommand}"
                        CommandParameter="true"
                        Content="加密"
                        Tag="M4 7H17M13 3L17 7L13 11"
                        Theme="{DynamicResource SolidButton}" />
                    <Button
                        Classes="actionIcon"
                        Command="{Binding Sm4HandlerCommand}"
                        CommandParameter="false"
                        Content="解密"
                        Tag="M7 13L3 17L7 21M3 17H16"
                        Theme="{DynamicResource OutlineButton}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 右列：密钥、内容类型与只读结果 -->
        <Border Grid.Column="1" Classes="tool-card-roomy" MinHeight="0">
            <!-- 行定义 Auto,Auto,Auto,*：结果编辑器吃掉剩余高度，避免贴底留白 -->
            <Grid MinHeight="0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{StaticResource Space.10}">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space.8}">
                    <TextBlock
                        Classes="section-copy"
                        Text="密钥与结果"
                        VerticalAlignment="Center" />

                    <ComboBox
                        Grid.Column="2"
                        MinWidth="140"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding Source={x:Static utils:EnumValuesHelper.OutTypeValues}}"
                        SelectedIndex="{Binding OutTypeValue}" />
                </Grid>

                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Space.6}">
                    <TextBlock Classes="metric-label" Text="密钥" />
                    <TextBox
                        Grid.Row="1"
                        Classes="Standard"
                        PlaceholderText="请输入密钥"
                        Text="{Binding Secret}" />
                </Grid>

                <TextBlock
                    Grid.Row="2"
                    Classes="metric-label"
                    Text="处理结果" />

                <TextBox
                    Grid.Row="3"
                    AcceptsReturn="True"
                    Classes="Standard"
                    MinHeight="0"
                    IsReadOnly="True"
                    PlaceholderText="处理后的内容将显示在这里"
                    Text="{Binding Ciphertext}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
