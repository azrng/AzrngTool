<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.Encrypts.AesEncryptPageView"
    x:DataType="vm:AesEncryptPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AzrngTools.ViewModels.Encrypts"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：左列原文/处理结果双编辑器与密钥参数撑满视口，右列参数设置；
         编辑器随窗口拉伸并在内部滚动 -->
    <Grid Margin="{StaticResource Thickness.15}" ColumnDefinitions="2*,1*" ColumnSpacing="{StaticResource Space.12}">
        <!-- 左列：原文 / 处理结果与密钥、IV -->
        <Border Grid.Column="0" Classes="tool-card-roomy" MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="{StaticResource Space.10}">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Space.8}">
                    <TextBlock
                        Classes="section-copy"
                        Text="原文 / 处理结果"
                        VerticalAlignment="Center" />
                    <!-- 密钥与 IV 的必要约束压缩为提示，悬停查看 -->
                    <Button
                        Grid.Column="1"
                        Classes="iconButton"
                        ToolTip.Tip="密钥长度需与算法匹配（16/24/32 字节）；ECB 模式可留空 IV，其它模式需按所选格式输入 IV。"
                        VerticalAlignment="Center">
                        <PathIcon
                            Data="M12 8H12.01M12 12V16M21 12A9 9 0 1 1 3 12A9 9 0 0 1 21 12Z"
                            Height="{StaticResource Layout.Icon.Sm}"
                            Width="{StaticResource Layout.Icon.Sm}" />
                    </Button>
                </Grid>

                <!-- 原文 / 处理结果左右两列，均分剩余高度 -->
                <Grid Grid.Row="1" MinHeight="0" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.12}">
                    <TextBox
                        Grid.Column="0"
                        AcceptsReturn="True"
                        Classes="Standard"
                        MinHeight="0"
                        PlaceholderText="请输入要加密或解密的内容"
                        Text="{Binding Original}" />

                    <TextBox
                        Grid.Column="1"
                        AcceptsReturn="True"
                        Classes="Standard"
                        MinHeight="0"
                        IsReadOnly="True"
                        PlaceholderText="加密或解密后的内容将显示在这里"
                        Text="{Binding Ciphertext}" />
                </Grid>

                <!-- 密钥 / IV 单行输入 -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.12}">
                    <Grid Grid.Column="0" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Space.6}">
                        <TextBlock Classes="metric-label" Text="密钥" />
                        <TextBox
                            Grid.Row="1"
                            Classes="Standard"
                            PlaceholderText="请输入密钥"
                            Text="{Binding Secret}" />
                    </Grid>

                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Space.6}">
                        <TextBlock Classes="metric-label" Text="IV" />
                        <TextBox
                            Grid.Row="1"
                            Classes="Standard"
                            PlaceholderText="ECB 模式可留空，其它模式请输入 IV"
                            Text="{Binding Iv}" />
                    </Grid>
                </Grid>

                <WrapPanel Grid.Row="3" Classes="tool-actions">
                    <Button
                        Classes="actionIcon"
                        Command="{Binding HandlerCommand}"
                        CommandParameter="true"
                        Content="加密"
                        Tag="M4 7H17M13 3L17 7L13 11"
                        Theme="{DynamicResource SolidButton}" />
                    <Button
                        Classes="actionIcon"
                        Command="{Binding HandlerCommand}"
                        CommandParameter="false"
                        Content="解密"
                        Tag="M7 13L3 17L7 21M3 17H16"
                        Theme="{DynamicResource OutlineButton}" />
                    <Button
                        Classes="actionIcon"
                        Command="{Binding ResetCommand}"
                        Content="清空"
                        Tag="M5 7H19M9 7V5H15V7M8 10V17M12 10V17M16 10V17M7 7L8 20H16L17 7"
                        Theme="{DynamicResource OutlineButton}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 右列：参数设置，窗口过矮时在卡片内滚动 -->
        <Border Grid.Column="1" Classes="tool-card-roomy" MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                <TextBlock
                    Grid.Row="0"
                    Classes="section-copy"
                    Text="参数设置"
                    VerticalAlignment="Center" />

                <ScrollViewer
                    Grid.Row="1"
                    MinHeight="0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="{StaticResource Space.10}">
                        <Border Classes="tool-card-soft">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.10}">
                                <TextBlock Classes="metric-label" Text="输入内容格式" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding InputOriginalTypeIndex}">
                                    <ComboBoxItem Content="Text" />
                                    <ComboBoxItem Content="Base64" />
                                    <ComboBoxItem Content="Hex" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Classes="tool-card-soft">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.10}">
                                <TextBlock Classes="metric-label" Text="输出结果格式" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding OutTypeIndex}">
                                    <ComboBoxItem Content="Base64" />
                                    <ComboBoxItem Content="Hex" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Classes="tool-card-soft">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.10}">
                                <TextBlock Classes="metric-label" Text="密钥 / IV 格式" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding SecretTypeIndex}">
                                    <ComboBoxItem Content="Text" />
                                    <ComboBoxItem Content="Base64" />
                                    <ComboBoxItem Content="Hex(十六进制)" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Classes="tool-card-soft">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.10}">
                                <TextBlock Classes="metric-label" Text="密码模式" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding CipherModeIndex}">
                                    <ComboBoxItem Content="请选择" />
                                    <ComboBoxItem Content="CBC(密码块链)" />
                                    <ComboBoxItem Content="ECB(电子密码本)" />
                                    <ComboBoxItem Content="OFB(输出反馈)" />
                                    <ComboBoxItem Content="CFB(密码反馈)" />
                                    <ComboBoxItem Content="CTS(密码文本窃用)" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Classes="tool-card-soft">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.10}">
                                <TextBlock Classes="metric-label" Text="填充模式" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding PaddingModeIndex}">
                                    <ComboBoxItem Content="请选择" />
                                    <ComboBoxItem Content="None" />
                                    <ComboBoxItem Content="PKCS7" />
                                    <ComboBoxItem Content="Zeros" />
                                    <ComboBoxItem Content="ANSIX923" />
                                    <ComboBoxItem Content="ISO10126" />
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
