<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.Encrypts.HashPageView"
    x:DataType="vm:HashPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:AzrngTools.Utils"
    xmlns:vm="using:AzrngTools.ViewModels.Encrypts"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 工具页统一布局：左列原文编辑器+算法按钮，右列只读散列结果，双列撑满视口；
         编辑器随窗口拉伸并在内部滚动 -->
    <Grid Margin="{StaticResource Thickness.15}" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.12}">
        <!-- 左列：原文与算法按钮 -->
        <Border Grid.Column="0" Classes="tool-card-roomy" MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space.10}">
                <TextBlock
                    Grid.Row="0"
                    Classes="section-copy"
                    Text="原文"
                    VerticalAlignment="Center" />

                <TextBox
                    Grid.Row="1"
                    AcceptsReturn="True"
                    Classes="Standard"
                    MinHeight="0"
                    PlaceholderText="请输入要进行哈希的内容"
                    Text="{Binding Original}" />

                <WrapPanel Grid.Row="2" Classes="tool-actions">
                    <Button Classes="actionIcon" Command="{Binding OriginalHandlerCommand}" CommandParameter="0" Content="MD5" Tag="M12 3L14.2 8.1L19.8 8.7L15.6 12.4L16.8 18L12 15L7.2 18L8.4 12.4L4.2 8.7L9.8 8.1L12 3Z" Theme="{DynamicResource SolidButton}" />
                    <Button Classes="actionIcon" Command="{Binding OriginalHandlerCommand}" CommandParameter="1" Content="SHA1" Tag="M12 3L14.2 8.1L19.8 8.7L15.6 12.4L16.8 18L12 15L7.2 18L8.4 12.4L4.2 8.7L9.8 8.1L12 3Z" Theme="{DynamicResource OutlineButton}" />
                    <Button Classes="actionIcon" Command="{Binding OriginalHandlerCommand}" CommandParameter="2" Content="SHA256" Tag="M12 3L14.2 8.1L19.8 8.7L15.6 12.4L16.8 18L12 15L7.2 18L8.4 12.4L4.2 8.7L9.8 8.1L12 3Z" Theme="{DynamicResource OutlineButton}" />
                    <Button Classes="actionIcon" Command="{Binding OriginalHandlerCommand}" CommandParameter="3" Content="SHA512" Tag="M12 3L14.2 8.1L19.8 8.7L15.6 12.4L16.8 18L12 15L7.2 18L8.4 12.4L4.2 8.7L9.8 8.1L12 3Z" Theme="{DynamicResource OutlineButton}" />
                    <Button Classes="actionIcon" Command="{Binding OriginalHandlerCommand}" CommandParameter="4" Content="SM3" Tag="M12 3L14.2 8.1L19.8 8.7L15.6 12.4L16.8 18L12 15L7.2 18L8.4 12.4L4.2 8.7L9.8 8.1L12 3Z" Theme="{DynamicResource OutlineButton}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 右列：只读散列结果与输出格式 -->
        <Border Grid.Column="1" Classes="tool-card-roomy" MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.10}">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource Space.8}">
                    <TextBlock
                        Classes="section-copy"
                        Text="散列结果"
                        VerticalAlignment="Center" />

                    <ComboBox
                        Grid.Column="2"
                        MinWidth="140"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding Source={x:Static utils:EnumValuesHelper.OutTypeValues}}"
                        SelectedIndex="{Binding OutTypeValue}" />

                    <Border
                        Grid.Column="3"
                        Classes="badge-pill"
                        VerticalAlignment="Center">
                        <TextBlock Classes="badge-text" Text="只读" />
                    </Border>
                </Grid>

                <TextBox
                    Grid.Row="1"
                    AcceptsReturn="True"
                    Classes="Standard"
                    MinHeight="0"
                    IsReadOnly="True"
                    PlaceholderText="哈希后的内容"
                    Text="{Binding Ciphertext}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
