<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AzrngTools.ViewModels.Database"
        xmlns:models="using:AzrngTools.Models.Database"
        xmlns:dto="using:AzrngTools.Models.Database.DTOs"
        mc:Ignorable="d"
        x:Class="AzrngTools.Views.Database.Workbench.ExportDialog"
        x:CompileBindings="False"
        x:DataType="vm:ExportDialogViewModel"
        x:Name="ExportDialogWindow"
        MinWidth="960"
        MinHeight="620"
        Height="620">

    <Design.DataContext>
        <vm:ExportDialogViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.exportDialogSurface">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.2XL}" />
            <Setter Property="BoxShadow" Value="{DynamicResource Shadow.LG}" />
        </Style>

        <Style Selector="Border.exportSectionCard">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Panel.Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.XL}" />
            <Setter Property="Padding" Value="{StaticResource Thickness.14}" />
        </Style>

        <Style Selector="Border.exportWizardHeader">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel.HeroBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="{StaticResource Thickness.16}" />
        </Style>

        <Style Selector="Border.exportStepBadge">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Strong}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
        </Style>

        <Style Selector="TextBlock.exportStepBadgeText">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
            <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Bold}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.exportFormGroup">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel.SubtleBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Panel.Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.LG}" />
            <Setter Property="Padding" Value="{StaticResource Thickness.12}" />
        </Style>

        <Style Selector="Border.exportFooter">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel.SubtleBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Panel.Stroke}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="{StaticResource Thickness.12}" />
        </Style>

        <Style Selector="Border.exportTag">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <Style Selector="TextBlock.exportTagText">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Strong}" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.BodySmall}" />
            <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Medium}" />
        </Style>

        <Style Selector="TextBlock.exportSectionTitle">
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.BodyLarge}" />
            <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.SemiBold}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        </Style>

        <Style Selector="TextBlock.exportSectionHint">
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.BodySmall}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TreeView.exportTree">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="TreeView.exportTree TreeViewItem">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="TreeView.exportTree TreeViewItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.Nav.HoverBackground}" />
        </Style>

        <Style Selector="TreeView.exportTree TreeViewItem:selected">
            <Setter Property="Background" Value="{DynamicResource Brush.Nav.SelectedBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        </Style>

        <Style Selector="TreeView.exportTree TreeViewItem > Border">
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="RadioButton.exportDocumentTypeOption">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.SemiBold}" />
        </Style>

        <Style Selector="Button.exportFooterSecondary">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel.SubtleBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Panel.SubtleBackground}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.XL}" />
            <Setter Property="Padding" Value="{StaticResource Thickness.14.4}" />
        </Style>

        <Style Selector="Button.exportFooterSecondary:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.Nav.HoverBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource Brush.App.Background}">
        <Border Margin="{StaticResource Thickness.16}"
                Padding="{StaticResource Thickness.16}"
                Classes="exportDialogSurface">
            <Grid RowDefinitions="Auto,*,Auto"
                  RowSpacing="{StaticResource Space.12}">
                <Border Classes="exportWizardHeader">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="{StaticResource Space.12}">
                        <Border Classes="exportStepBadge">
                            <TextBlock Text="↗"
                                       Classes="exportStepBadgeText" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Spacing="{StaticResource Space.4}">
                            <TextBlock Text="导出向导"
                                       Classes="heading" />
                            <TextBlock Text="先选择对象，再配置输出格式；底部会汇总本次导出内容。"
                                       Classes="caption" />
                        </StackPanel>

                        <Border Grid.Column="2"
                                Classes="exportTag"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConnectionSummary}"
                                       Classes="exportTagText" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      ColumnDefinitions="1.25*,0.95*"
                      ColumnSpacing="{StaticResource Space.12}"
                      MinHeight="0">
                    <Border Grid.Column="0"
                            Classes="exportSectionCard"
                            MinHeight="0">
                        <Grid RowDefinitions="Auto,Auto,*"
                              RowSpacing="{StaticResource Space.10}"
                              MinHeight="0">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="{StaticResource Space.10}">
                                <Border Classes="exportStepBadge">
                                    <TextBlock Text="1"
                                               Classes="exportStepBadgeText" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Spacing="{StaticResource Space.2}">
                                    <TextBlock Text="选择导出对象"
                                               Classes="exportSectionTitle" />
                                    <TextBlock Text="在对象树中勾选本次需要导出的表、视图或存储过程。"
                                               Classes="exportSectionHint" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="{StaticResource Space.8}"
                                            VerticalAlignment="Center">
                                    <Button Command="{Binding SelectAllCommand}"
                                            Classes="secondary">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                            <PathIcon Data="M5 4H19V20H5V4ZM8 8H16M8 12H16M8 16H13" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                            <TextBlock Text="全选" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ClearSelectionCommand}"
                                            Classes="secondary">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                            <PathIcon Data="M5 7H19M9 7V5H15V7M8 10V17M12 10V17M16 10V17M7 7L8 20H16L17 7" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                            <TextBlock Text="清空" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1"
                                    Classes="toolbarStatCard">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10">
                                    <Border Classes="metricIconBadge">
                                        <TextBlock Text="DB"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Accent.Strong}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Spacing="2">
                                        <TextBlock Text="{Binding ConnectionName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding DatabaseLabel}"
                                                   Classes="caption" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Classes="browserTreeSurface"
                                    Margin="0"
                                    MinHeight="0">
                                <Grid MinHeight="0">
                                    <ScrollViewer Classes="browserTreeScroll"
                                                  MinHeight="0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  IsScrollChainingEnabled="False"
                                                  IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                                        <StackPanel Margin="6"
                                                    Spacing="10">
                                            <Border Classes="exportSectionCard"
                                                    IsVisible="{Binding HasLoadError}">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="对象加载失败"
                                                               Classes="exportSectionTitle" />
                                                    <TextBlock Text="{Binding LoadErrorMessage}"
                                                               Classes="exportSectionHint" />
                                                    <Button Command="{Binding RetryLoadCommand}"
                                                            Classes="modern"
                                                            HorizontalAlignment="Left">
                                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                                            <PathIcon Data="M19 8A7 7 0 1 0 20 12M19 4V8H15" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                                            <TextBlock Text="重新加载" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>

                                            <Border Classes="exportSectionCard"
                                                    IsVisible="{Binding HasObjects, Converter={StaticResource InvertedBoolConverter}}">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="暂无可导出的对象"
                                                               Classes="exportSectionTitle" />
                                                    <TextBlock Text="当前连接下没有加载到可导出的表。"
                                                               Classes="exportSectionHint" />
                                                </StackPanel>
                                            </Border>

                                            <TreeView Classes="exportTree"
                                                      ItemsSource="{Binding ExportRootChildren}"
                                                      IsVisible="{Binding HasObjects}">
                                                <TreeView.DataTemplates>
                                                    <TreeDataTemplate DataType="models:TreeNodeItem"
                                                                      ItemsSource="{Binding Children}">
                                                        <Grid ColumnDefinitions="Auto,Auto,8,*"
                                                              Margin="0,3">
                                                            <CheckBox Grid.Column="0"
                                                                      IsVisible="{Binding ShowExportCheckBox}"
                                                                      IsThreeState="True"
                                                                      IsChecked="{Binding IsExportChecked, Mode=TwoWay}"
                                                                      VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding IconGlyph}"
                                                                       FontSize="15"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding DisplayName}"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                                                       TextWrapping="Wrap" />
                                                        </Grid>
                                                    </TreeDataTemplate>
                                                </TreeView.DataTemplates>
                                            </TreeView>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <StackPanel IsVisible="{Binding IsLoading}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="12">
                                        <ProgressBar Width="220"
                                                     IsIndeterminate="True" />
                                        <TextBlock Text="{Binding LoadingText}"
                                                   Classes="caption"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Classes="exportSectionCard"
                            MinHeight="0">
                        <Grid RowDefinitions="Auto,Auto,*"
                              RowSpacing="{StaticResource Space.10}"
                              MinHeight="0">
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="{StaticResource Space.10}">
                                <Border Classes="exportStepBadge">
                                    <TextBlock Text="2"
                                               Classes="exportStepBadgeText" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Spacing="{StaticResource Space.2}">
                                    <TextBlock Text="配置输出"
                                               Classes="exportSectionTitle" />
                                    <TextBlock Text="填写文件信息并选择适合接收方的文档格式。"
                                               Classes="exportSectionHint" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1"
                                    Classes="exportFormGroup">
                                <StackPanel Spacing="{StaticResource Space.12}">
                                    <StackPanel Spacing="{StaticResource Space.8}">
                                        <TextBlock Text="文档名称"
                                                   Classes="label" />
                                        <TextBox Text="{Binding DocumentName}"
                                                 PlaceholderText="请输入文档名称"
                                                 Classes="modern" />
                                    </StackPanel>
                                    <StackPanel Spacing="{StaticResource Space.8}">
                                        <TextBlock Text="输出路径"
                                                   Classes="label" />
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="{StaticResource Space.10}">
                                            <TextBox Text="{Binding OutputDirectory}"
                                                     IsReadOnly="True"
                                                     Classes="modern" />
                                            <Button Grid.Column="1"
                                                    Click="OnBrowseOutputDirectoryClick"
                                                    Classes="secondary">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                                    <PathIcon Data="M5 4H19V20H5V4ZM8 8H16M8 12H16M8 16H13" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                                    <TextBlock Text="浏览..." FontWeight="Medium" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2"
                                    Classes="exportFormGroup"
                                    MinHeight="0">
                                <Grid RowDefinitions="Auto,Auto,Auto"
                                      RowSpacing="{StaticResource Space.10}"
                                      MinHeight="0">
                                    <TextBlock Text="文档格式"
                                               Classes="label" />
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding DocumentTypeHint}"
                                               Classes="exportSectionHint" />
                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                Spacing="{StaticResource Space.16}">
                                        <RadioButton Content="Excel (.xlsx)"
                                                     GroupName="ExportDocumentType"
                                                     IsChecked="{Binding IsExcelSelected, Mode=OneWay}"
                                                     Command="{Binding SelectDocumentTypeCommand}"
                                                     CommandParameter="{x:Static dto:ExportDocumentType.Excel}"
                                                     Classes="exportDocumentTypeOption" />
                                        <RadioButton Content="Markdown (.md)"
                                                     GroupName="ExportDocumentType"
                                                     IsChecked="{Binding IsMarkdownSelected, Mode=OneWay}"
                                                     Command="{Binding SelectDocumentTypeCommand}"
                                                     CommandParameter="{x:Static dto:ExportDocumentType.Markdown}"
                                                     Classes="exportDocumentTypeOption" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Classes="exportFooter">
                    <Grid ColumnDefinitions="*,Auto,Auto"
                           ColumnSpacing="{StaticResource Space.12}">
                        <StackPanel Spacing="{StaticResource Space.2}">
                            <TextBlock Text="导出清单"
                                       Classes="label" />
                            <TextBlock Text="{Binding SelectionSummary}"
                                       Classes="caption" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding CancelCommand}"
                                Classes="exportFooterSecondary"
                                Padding="{StaticResource Thickness.14.4}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                <PathIcon Data="M6 6L18 18M18 6L6 18" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                <TextBlock Text="取消" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Command="{Binding ExportCommand}"
                                Classes="accent"
                                Padding="{StaticResource Thickness.14.4}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.6}">
                                <PathIcon Data="M12 4V16M8 12L12 16L16 12M5 20H19" Height="{StaticResource Layout.Icon.Sm}" Width="{StaticResource Layout.Icon.Sm}" />
                                <TextBlock Text="开始导出" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
