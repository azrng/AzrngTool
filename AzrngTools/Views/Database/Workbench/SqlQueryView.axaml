<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AzrngTools.ViewModels.Database"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="720"
             x:Class="AzrngTools.Views.Database.Workbench.SqlQueryView"
             x:CompileBindings="False">

    <Design.DataContext>
        <vm:SqlQueryViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto,*"
          RowSpacing="{StaticResource Space.12}"
          MinHeight="0">
        <Border Grid.Row="0"
                Classes="tool-card-subtle"
                IsVisible="{Binding IsLoading}">
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource Space.8}">
                <ProgressBar Width="24"
                             Height="18"
                             IsIndeterminate="True" />
                <TextBlock Text="{Binding LoadingText}"
                           Classes="body"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Classes="workspaceQueryEditor"
                MinHeight="220">
            <Grid RowDefinitions="Auto,*"
                  MinHeight="0">
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="{StaticResource Space.10}"
                      RowSpacing="{StaticResource Space.8}">
                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Spacing="{StaticResource Space.2}">
                        <TextBlock Text="SQL 查询"
                                   Classes="subheading" />
                        <TextBlock Text="{Binding CurrentConnection.Name, FallbackValue=未选择连接}"
                                   Classes="caption"
                                   MaxWidth="220"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding CurrentSchemaName, FallbackValue=未选择架构}"
                               Classes="caption"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <Button Grid.Row="0"
                            Grid.Column="2"
                            Command="{Binding ExecuteQueryCommand}"
                            Classes="workbenchAccentAction"
                            Padding="{StaticResource Thickness.14.4}"
                            VerticalAlignment="Center">
                        <TextBlock Text="执行"
                                   FontWeight="SemiBold" />
                    </Button>

                    <Button Grid.Row="0"
                            Grid.Column="3"
                            Click="OnFormatSqlClick"
                            Classes="workbenchToolbarAction"
                            Padding="{StaticResource Thickness.14.4}"
                            ToolTip.Tip="整理 SQL 排版">
                        <TextBlock Text="格式化" />
                    </Button>

                    <Button Grid.Row="0"
                            Grid.Column="4"
                            Command="{Binding ClearResultsCommand}"
                            Classes="workbenchToolbarAction"
                            Padding="{StaticResource Thickness.14.4}">
                        <TextBlock Text="清空结果" />
                    </Button>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="快速带入"
                               Classes="caption"
                               VerticalAlignment="Center" />

                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              ItemsSource="{Binding Templates}"
                              SelectedItem="{Binding SelectedTemplate}"
                              PlaceholderText="选择模板"
                              Classes="modern">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Command="{Binding ApplyTemplateCommand}"
                            CommandParameter="{Binding SelectedTemplate}"
                            Classes="workbenchToolbarAction">
                        <TextBlock Text="使用模板" />
                    </Button>

                    <ComboBox Grid.Row="1"
                              Grid.Column="3"
                              Grid.ColumnSpan="2"
                              ItemsSource="{Binding QueryHistory}"
                              SelectedItem="{Binding SelectedHistoryItem}"
                              PlaceholderText="最近执行记录"
                              Classes="modern" />

                    <Button Grid.Row="1"
                            Grid.Column="5"
                            Command="{Binding LoadHistoryCommand}"
                            CommandParameter="{Binding SelectedHistoryItem}"
                            Classes="workbenchToolbarAction">
                        <TextBlock Text="复用" />
                    </Button>
                </Grid>

                <TextBox Grid.Row="1"
                         x:Name="SqlEditor"
                         Text="{Binding SqlText, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="{DynamicResource Font.Family.Monospace}"
                         Classes="sqlEditor"
                         MinHeight="160" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Classes="queryResultHeader">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="{StaticResource Space.12}">
                <StackPanel Spacing="{StaticResource Space.2}">
                    <TextBlock Text="结果"
                               Classes="subheading" />
                    <TextBlock Text="{Binding ResultMessage, FallbackValue=执行查询后，结果会显示在这里。}"
                               Classes="caption"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding AffectedRows, StringFormat=影响行数：{0}}"
                           Classes="caption"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Classes="queryResultSurface"
                MinHeight="180"
                MinWidth="0">
            <Grid MinHeight="0">
                <Border Padding="{StaticResource Thickness.24}"
                        IsVisible="{Binding HasResults, Converter={StaticResource InvertedBoolConverter}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="{StaticResource Space.8}">
                        <TextBlock Text="暂无结果"
                                   Classes="subheading"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="执行 SELECT 查看结果集；写入类语句会在上方显示影响行数。"
                                   Classes="caption"
                                   HorizontalAlignment="Center"
                                   MaxWidth="520"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <DataGrid x:Name="ResultGrid"
                          IsVisible="{Binding HasResults}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
