<!-- UrsaWindow 的标题栏是悬浮层不占布局，内容需通过 Padding 自行避让，
     顶部 32 为 UrsaWindow 默认标题栏高度 -->
<u:UrsaWindow
    Icon="/Assets/logo.ico"
    Height="{StaticResource Layout.MainWindow.Height}"
    MinHeight="{StaticResource Layout.MainWindow.MinHeight}"
    MinWidth="{StaticResource Layout.MainWindow.MinWidth}"
    Width="{StaticResource Layout.MainWindow.Width}"
    WindowStartupLocation="CenterScreen"
    Title="AzrngTools"
    IsFullScreenButtonVisible="False"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="AzrngTools.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    x:Name="RootWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="using:AzrngTools.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 标题栏配色：Semi 默认标题栏为透明且其资源无法从应用侧覆盖，故用独立键名自绘
         标题底条与分隔线（第 0/1 行），拖拽与窗口按钮仍由 Ursa 悬浮标题栏负责，随明暗主题切换 -->
    <u:UrsaWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TitleBar.Strip">#F7F8FA</SolidColorBrush>
                    <SolidColorBrush x:Key="TitleBar.Separator">#E5E7EB</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TitleBar.Strip">#1C1C1F</SolidColorBrush>
                    <SolidColorBrush x:Key="TitleBar.Separator">#333338</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TitleBar.Strip">#F7F8FA</SolidColorBrush>
                    <SolidColorBrush x:Key="TitleBar.Separator">#E5E7EB</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </u:UrsaWindow.Resources>

    <!-- 标题栏由 UrsaWindow 托管装饰提供：拖动、双击最大化、最小化/最大化/关闭按钮均由库渲染；
         IsFullScreenButtonVisible 固定关闭以保持原有 三键 布局 -->
    <u:UrsaWindow.TitleBarContent>
        <TextBlock
            Classes="app-title"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Text="{Binding AppTitle}" />
    </u:UrsaWindow.TitleBarContent>

    <!-- Mode=Indicator 从实际主题变体同步（实际变体永不为 Default），
         避免初始请求变体为 Default 时非三态按钮首次点击抛出异常 -->
    <u:UrsaWindow.RightContent>
        <u:ThemeToggleButton
            Mode="Indicator"
            IsThreeState="False" />
    </u:UrsaWindow.RightContent>

    <!-- 标题底条(32px，与 Ursa 默认标题栏同高) + 分隔线 + 内容区；
         Ursa 标题栏文字与窗口按钮悬浮其上，拖拽热区不受影响 -->
    <Grid RowDefinitions="32,1,*">
        <Border
            Grid.Row="0"
            Background="{DynamicResource TitleBar.Strip}" />
        <Border
            Grid.Row="1"
            Background="{DynamicResource TitleBar.Separator}" />
        <Grid Grid.Row="2" Margin="{StaticResource Thickness.12}">
            <Grid ColumnSpacing="{StaticResource Space.12}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Classes="shell-sidebar">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="{StaticResource Space.12}">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.8}">
                        <TextBox
                            Classes="clearButton"
                            Text="{Binding SearchKeyword}"
                            IsVisible="{Binding !IsSidebarCollapsed}"
                            PlaceholderText="搜索工具 / 分组..." />
                        <Button
                            Grid.Column="1"
                            Classes="iconButton sidebarToggleButton"
                            Command="{Binding ToggleSidebarCommand}"
                            HorizontalAlignment="Right"
                            ToolTip.Tip="切换侧栏">
                            <PathIcon
                                Data="{Binding SidebarToggleIconPath}"
                                Height="{StaticResource Layout.Icon.Sm}"
                                Width="{StaticResource Layout.Icon.Sm}" />
                        </Button>
                    </Grid>

                    <!-- 侧栏收起时隐藏统计与分组导航，只保留切换按钮与首页，避免出现孤箭头和竖排文字 -->
                    <Border
                        Grid.Row="1"
                        Classes="tool-card-soft sidebar-stats"
                        IsVisible="{Binding !IsSidebarCollapsed}">
                        <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="{StaticResource Space.10}">
                            <Button
                                Grid.Column="0"
                                Classes="Tertiary"
                                Command="{Binding GoHomeCommand}"
                                Padding="{StaticResource Thickness.12}"
                                Theme="{DynamicResource BorderlessButton}"
                                ToolTip.Tip="首页">
                                <PathIcon
                                    Data="M10 20V14H14V20H19V12H22L12 3L2 12H5V20H10Z"
                                    Foreground="{DynamicResource Brush.Accent.Strong}"
                                    Height="{StaticResource Layout.Icon.Sm}"
                                    Width="{StaticResource Layout.Icon.Sm}" />
                            </Button>
                            <StackPanel Grid.Column="1" IsVisible="{Binding !IsSidebarCollapsed}" Spacing="{StaticResource Space.2}">
                                <TextBlock Classes="metric-label" Text="总工具" />
                                <TextBlock Classes="metric-value compact" Text="{Binding TotalToolCount}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" IsVisible="{Binding !IsSidebarCollapsed}" Spacing="{StaticResource Space.2}">
                                <TextBlock Classes="metric-label" Text="分类" />
                                <TextBlock Classes="metric-value compact" Text="{Binding CategoryCount}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 常用入口功能暂未启用 -->
                    <!-- <TextBlock
                        Grid.Row="2"
                        Classes="sidebar-section-caption"
                        Text="常用入口" />

                    <ListBox
                        Grid.Row="3"
                        Classes="shell-nav"
                        ItemsSource="{Binding RootMenuItems}"
                        SelectedItem="{Binding SelectedListItem, Mode=OneWay}"
                        SelectionChanged="OnCommonListBoxSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Classes="nav-item-text" Text="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox> -->

                    <TextBlock
                        Grid.Row="4"
                        Classes="sidebar-section-caption"
                        IsVisible="{Binding !IsSidebarCollapsed}"
                        Text="{Binding SearchSummary}" />

                    <ScrollViewer Grid.Row="5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsSidebarCollapsed}">
                        <ItemsControl ItemsSource="{Binding GroupMenuItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.8}">
                                                <TextBlock
                                                    Classes="nav-group-title"
                                                    IsVisible="{Binding #RootWindow.DataContext.IsSidebarCollapsed, Converter={x:Static BoolConverters.Not}}"
                                                    Text="{Binding Title}"
                                                    VerticalAlignment="Center" />
                                                <Border
                                                    Grid.Column="1"
                                                    Classes="badge-pill compact"
                                                    IsVisible="{Binding #RootWindow.DataContext.IsSidebarCollapsed, Converter={x:Static BoolConverters.Not}}"
                                                    VerticalAlignment="Center">
                                                    <TextBlock Classes="badge-text" Text="{Binding Child.Count}" />
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <ListBox
                                            Classes="shell-nav"
                                            ItemsSource="{Binding Child}"
                                            SelectionChanged="OnGroupListBoxSelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*">
                                                        <TextBlock
                                                            Classes="nav-item-text"
                                                            IsVisible="{Binding #RootWindow.DataContext.IsSidebarCollapsed, Converter={x:Static BoolConverters.Not}}"
                                                            Text="{Binding Title}"
                                                            VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Border Classes="shell-panel">
                    <!-- 内容宿主不再包 ScrollViewer：页面自管滚动，根级 * 行才能拿到确定高度撑满视口；
                         长内容页面一律在自身卡片/编辑器内部滚动 -->
                    <!-- 使用 ContentControl 而非 TransitioningContentControl：
                         页面 View 已按实例缓存复用，过渡动画会在新旧页面交叠期间双份渲染并与复用的
                         View 产生父子冲突，同时也是切换卡顿来源之一 -->
                    <ContentControl Content="{Binding CurrentPage}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch" />
                </Border>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</u:UrsaWindow>
